---
// AvailabilityBanner.astro
// Live availability status, shown right below the hero.
// No props needed — all logic runs client-side from the visitor's local time
// (the schedule in the script below is the business's own; do not change it here
// without the owner).
import { telHref } from '../config/site';
---

<div id="availability-banner" aria-live="polite">
  <div class="banner-inner">
    <span class="banner-dot" id="banner-dot"></span>
    <span class="banner-text" id="banner-text"></span>
    <a class="banner-cta" id="banner-cta" href={telHref}></a>
  </div>
</div>

<style>
  #availability-banner {
    display: flex;
    justify-content: center;
    padding: 0.85rem var(--gutter);
    border-bottom: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
    font-size: var(--text-sm);
    transition: background-color 0.4s ease;
  }

  #availability-banner.status-open { background: var(--success-bg); border-color: #cfe6d7; }
  #availability-banner.status-limited { background: var(--warning-bg); border-color: #f0dfb8; }
  #availability-banner.status-closed { background: var(--sand); }

  .banner-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem 1rem;
    max-width: 960px;
    text-align: center;
  }

  .banner-dot {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--muted);
  }

  .status-open .banner-dot { background: var(--success); animation: pulse-green 2s infinite; }
  .status-limited .banner-dot { background: #c98a15; animation: pulse-yellow 2s infinite; }
  .status-closed .banner-dot { background: var(--danger); }

  @keyframes pulse-green {
    0%   { box-shadow: 0 0 0 0 rgb(46 125 79 / 0.45); }
    70%  { box-shadow: 0 0 0 8px rgb(46 125 79 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(46 125 79 / 0); }
  }

  @keyframes pulse-yellow {
    0%   { box-shadow: 0 0 0 0 rgb(201 138 21 / 0.45); }
    70%  { box-shadow: 0 0 0 8px rgb(201 138 21 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(201 138 21 / 0); }
  }

  .banner-text {
    line-height: 1.5;
  }

  .banner-cta {
    flex-shrink: 0;
    padding: 0.4rem 0.95rem;
    border-radius: var(--radius-sm);
    background: var(--navy);
    color: var(--white);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .banner-cta:hover {
    background: var(--navy-700);
    color: var(--white);
  }

  .banner-cta:empty {
    display: none;
  }
</style>

<script>
  (function () {
    const banner = document.getElementById('availability-banner');
    const text   = document.getElementById('banner-text');
    const cta    = document.getElementById('banner-cta');

    if (!banner || !text || !cta) return;

    // ── Replace with your actual number ───────────────────────────────────────
    const PHONE = 'tel:+19895720303';
    const SMS   = 'sms:+19895720303';
    // ─────────────────────────────────────────────────────────────────────────

    const now = new Date();            // '2026-05-14T12:30:00' example for testing 12:30pm march 14th
    const day = now.getDay();                              // 0=Sun 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri 6=Sat
    const t   = now.getHours() + now.getMinutes() / 60;   // decimal time e.g. 13.5 = 1:30pm

    function greeting() {
      if (t >= 5  && t < 12) return 'Good morning. ';
      if (t >= 12 && t < 17) return 'Good afternoon. ';
      if (t >= 17 && t < 21) return 'Good evening. ';
      return 'Late night troubles? '; // overnight — no greeting reads more natural
    }
    const g = greeting();

    // ── Message buckets ───────────────────────────────────────────────────────

    function setOpenDay() {
      banner.classList.add('status-open');
      text.textContent = g + "We're available now — call or text and we'll see about getting someone out to you today.";
      cta.textContent  = 'Call Now';
      cta.href         = PHONE;
    }

    function setOpenNight() {
      banner.classList.add('status-open');
      text.textContent = g + "We're available right now — call or text to get started. We may be able to get out to you.";
      cta.textContent  = 'Call Now';
      cta.href         = PHONE;
    }

    function setSleeping() {
      banner.classList.add('status-closed');
      text.textContent = g + "We're out of the office until this afternoon — leave us a message and we'll get back to you as soon as we're back.";
      cta.textContent  = 'Leave a Message';
      cta.href         = SMS;
    }

    function setCasinoAfternoon() {
      banner.classList.add('status-limited');
      text.textContent = g + "Give us a call — we'd love to help. We'll get you taken care of as soon as possible.";
      cta.textContent  = 'Call Now';
      cta.href         = PHONE;
    }

    function setCasinoShift() {
      banner.classList.add('status-limited');
      text.textContent = g + "We're monitoring messages tonight and typically respond within the hour. Text us and we'll get you taken care of.";
      cta.textContent  = 'Text Us';
      cta.href         = SMS;
    }

    // ── Routing ───────────────────────────────────────────────────────────────
    //
    // SUN (0):  midnight–6am  = casino shift carryover from Sat night
    //           6am–1pm       = sleeping
    //           1pm–midnight  = open
    //
    // MON (1):  midnight–6am  = open (off-day overnight)
    // TUE (2):  6am–1pm       = sleeping
    //           1pm–midnight  = open
    //
    // WED (3):  midnight–6am  = open (Tue night off carryover)
    //           6am–1pm       = sleeping
    //           1pm–8pm       = casino afternoon
    //           8pm–midnight  = casino shift
    //
    // THU (4):  midnight–1pm  = sleeping (Wed shift carryover + morning)
    // FRI (5):  1pm–8pm       = casino afternoon
    // SAT (6):  8pm–midnight  = casino shift

    switch (day) {

      case 0: // Sunday
        if      (t < 6)  setCasinoShift();    // Sat night shift still running
        else if (t < 13) setSleeping();
        else             setOpenDay();
        break;

      case 1: // Monday
      case 2: // Tuesday
        if      (t < 6)  setOpenNight();
        else if (t < 13) setSleeping();
        else             setOpenDay();
        break;

      case 3: // Wednesday
        if      (t < 6)  setOpenNight();      // Tue night off carryover
        else if (t < 13) setSleeping();
        else if (t < 20) setCasinoAfternoon();
        else             setCasinoShift();
        break;

      case 4: // Thursday
      case 5: // Friday
      case 6: // Saturday
        if      (t < 6)  setCasinoShift();
        else if (t < 13) setSleeping();       // shift carryover + morning sleep
        else if (t < 20) setCasinoAfternoon();
        else             setCasinoShift();
        break;
    }

  })();
</script>