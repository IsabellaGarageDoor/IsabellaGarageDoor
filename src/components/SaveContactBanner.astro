---
// src/components/SaveContactBanner.astro
// Phone-only prompt to download the business vCard.
import Icon from './ui/Icon.astro';
---

<div class="save-banner">
  <div class="save-banner-inner">
    <div class="save-banner-icon">
      <Icon name="user" size="1.3em" />
    </div>
    <div class="save-banner-text">
      <p class="save-banner-eyebrow">Did you know?</p>
      <p class="save-banner-copy">You can save our contact in one tap — keep our number handy for easy warranty support, quick questions, or future service.</p>
      <a href="/isabella-garage-door.vcf" class="btn btn--primary btn--sm save-banner-btn">
        <Icon name="download" size="1.1em" />
        Save My Contact
      </a>
    </div>
  </div>
</div>

<style>
  .save-banner {
    display: none; /* mobile only */
    margin: var(--space-8) 0;
  }

  @media (max-width: 768px) {
    .save-banner {
      display: block;
    }
  }

  .save-banner-inner {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--bronze-200);
    border-radius: var(--radius);
    background: var(--bronze-50);
  }

  .save-banner-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--navy);
    color: var(--bronze-300);
  }

  .save-banner-text {
    flex: 1;
    min-width: 0;
  }

  .save-banner-eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--bronze-700);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .save-banner-copy {
    margin: 0;
    color: var(--text);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.5;
    text-align: left;
  }

  .save-banner-btn {
    min-height: 48px;
    margin-top: var(--space-4);
    text-decoration: none;
  }
</style>
