---
// Share links (Facebook, X/Twitter, LinkedIn) and a copy-link button.
import Icon from './ui/Icon.astro';
import { site } from '../config/site';

interface Props {
  /** Public path of the page, e.g. /blog/my-post */
  url: string;
}
const { url } = Astro.props;
const fullUrl = encodeURIComponent(`${site.url}${url}`);
const links = [
  { label: 'Share on Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${fullUrl}`, icon: 'facebook' },
  { label: 'Share on Twitter', href: `https://twitter.com/intent/tweet?url=${fullUrl}`, icon: 'twitter' },
  { label: 'Share on LinkedIn', href: `https://www.linkedin.com/shareArticle?mini=true&url=${fullUrl}`, icon: 'linkedin' },
];
---

<div class="share-buttons">
  {links.map((l) => (
    <a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={`${l.label} (opens in a new tab)`}>
      <Icon name={l.icon} />
    </a>
  ))}
  <button type="button" id="copyLinkBtn" aria-label="Copy link">
    <Icon name="link" />
  </button>
  <span class="share-buttons__status" role="status" aria-live="polite"></span>
</div>

<script>
  const btn = document.getElementById('copyLinkBtn');
  const status = document.querySelector<HTMLElement>('.share-buttons__status');
  btn?.addEventListener('click', async () => {
    const url = 'https://isabellagaragedoor.com' + window.location.pathname;
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(url);
      } else {
        const textarea = document.createElement('textarea');
        textarea.value = url;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'absolute';
        textarea.style.left = '-9999px';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
      }
      if (status) {
        status.textContent = 'Link copied!';
        setTimeout(() => (status.textContent = ''), 2500);
      }
    } catch (err) {
      console.error('Copy link failed', err);
    }
  });
</script>

<style>
  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .share-buttons a,
  .share-buttons button {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--white);
    color: var(--navy);
    transition: background-color var(--duration) var(--ease), color var(--duration) var(--ease), border-color var(--duration) var(--ease);
  }

  .share-buttons a:hover,
  .share-buttons button:hover {
    border-color: var(--navy);
    background: var(--navy);
    color: var(--white);
  }

  .share-buttons__status {
    margin-left: var(--space-2);
    color: var(--success);
    font-size: var(--text-sm);
    font-weight: 500;
  }
</style>
