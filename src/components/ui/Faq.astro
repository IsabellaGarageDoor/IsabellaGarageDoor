---
// FAQ list built on native <details> (keyboard accessible, works without JS).
// Renders the FAQPage structured data from the same items, so the visible
// answers and the schema can never drift apart.
import { faqPageSchema, type FaqItem } from '../../lib/schema';
import Icon from './Icon.astro';

interface Props {
  items: FaqItem[];
  heading?: string;
  eyebrow?: string;
  intro?: string;
  /** Emit FAQPage JSON-LD (default true) */
  schema?: boolean;
  id?: string;
  /** Allow several answers open at once (default: one at a time) */
  multiple?: boolean;
}

const { items, heading, eyebrow = 'FAQ', intro, schema = true, id = 'faq', multiple = false } = Astro.props;
const group = multiple ? undefined : `faq-${id}`;
---

<section class="section faq" id={id}>
  <div class="container container--narrow">
    {heading && (
      <div class="section-head">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h2>{heading}</h2>
        {intro && <p set:html={intro} />}
      </div>
    )}
    <div class="faq__list">
      {items.map((item) => (
        <details class="faq-item" name={group}>
          <summary>
            <span set:html={item.question} />
            <Icon name="chevron-down" class="faq-item__chev" />
          </summary>
          <div class="faq-item__answer" set:html={item.answer} />
        </details>
      ))}
    </div>
    <slot />
  </div>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema(items))} />}
</section>

<style>
  .faq__list {
    border-top: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-1);
    color: var(--navy);
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 600;
    line-height: var(--leading-snug);
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:hover {
    color: var(--bronze-700);
  }

  .faq-item :global(.faq-item__chev) {
    flex-shrink: 0;
    color: var(--bronze-600);
    transition: transform var(--duration) var(--ease);
  }

  .faq-item[open] :global(.faq-item__chev) {
    transform: rotate(180deg);
  }

  .faq-item__answer {
    padding: 0 var(--space-1) var(--space-6);
    color: var(--text);
  }

  .faq-item__answer > :global(* + *) {
    margin-top: var(--space-3);
  }

  .faq-item__answer :global(a) {
    color: var(--bronze-700);
    text-decoration: underline;
  }
</style>
