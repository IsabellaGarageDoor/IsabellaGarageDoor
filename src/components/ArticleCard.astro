---
// Blog article card (thumbnail, title, description, date).
import type { CollectionEntry } from 'astro:content';
import Icon from './ui/Icon.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  hidden?: boolean;
  /** Show the publish date */
  showDate?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { post, hidden = false, showDate = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const date = post.data.pubDate
  ? new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : '';
---

<article class="article-card" hidden={hidden}>
  <a href={`/blog/${post.id}`} class="article-card__link">
    {post.data.thumbnail && (
      <img
        src={post.data.thumbnail}
        alt={post.data.title || 'Garage door article'}
        loading="lazy"
        decoding="async"
        class="article-card__img"
      />
    )}
    <div class="article-card__body">
      {showDate && date && <time datetime={post.data.pubDate}>{date}</time>}
      <Heading class="article-card__title">{post.data.title || 'Untitled Article'}</Heading>
      {post.data.description && <p>{post.data.description}</p>}
      <span class="link-arrow article-card__more">Read More <Icon name="arrow-right" size="1em" /></span>
    </div>
  </a>
</article>

<style>
  .article-card {
    display: flex;
  }

  .article-card__link {
    display: flex;
    flex: 1;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    transition: box-shadow var(--duration) var(--ease), transform var(--duration) var(--ease);
  }

  .article-card__link:hover {
    color: inherit;
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  .article-card__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--sand);
  }

  .article-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
  }

  .article-card__body time {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .article-card__title {
    font-size: 1.2rem;
    line-height: var(--leading-snug);
  }

  .article-card__body p {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .article-card__more {
    margin-top: auto;
    padding-top: var(--space-2);
  }
</style>
