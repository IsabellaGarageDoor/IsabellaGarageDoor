<style>
  .value-icons-wrapper {
    overflow: visible;
  }

  .value-icons-section {
    max-width: 1000px;
    margin-inline: auto;
    overflow: visible;
  }

  .value-icon-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1rem;
    padding: 0rem;
    width: 100%;
    box-sizing: border-box;
    overflow: visible;
  }

  @media (min-width: 900px) {
    .value-icon-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Card base configuration */
  .value-icon-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #ffffff;
    border: 0.094rem solid #b27d57;
    border-radius: 0.75rem;
    padding: 1.5rem 1rem; /* Slightly balanced padding */
    width: 100%;
    box-sizing: border-box;
    max-width: 100%;
    min-height: 250px; /* Increased slightly to accommodate longer text lengths cleanly */
    box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.4);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-align: center;
    overflow-x: hidden;
    position: relative;

    background-image: url('/photos/white-garage-door-service-section.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 1;

    opacity: 0;
    transform: translateY(20px);
    animation-fill-mode: forwards;
  }

  /* Light overlay */
  .value-icon-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: rgba(255, 255, 255, 0.5);
    z-index: 0;
    border-radius: inherit;
  }

  .value-icon-card * {
    position: relative;
    z-index: 2;
  }

  /* Hover effects */
  .value-icon-card:hover {
    box-shadow: 0 0 1rem rgba(178, 125, 87, 0.85);
    border-color: #b27d57;
    outline: none;
    transform: translateY(-5px) scale(1.03);
    cursor: pointer;
  }

  /* Global Uniform Image Handling */
  .homeowner-toolbox-img {
    height: 50px;
    width: auto;
    object-fit: contain; /* Prevents non-square logos from distorting layout */
    margin-bottom: 1.25rem; /* Clean, fixed separation layer */
    display: block;
  }

  /* Body Content Framework */
  .value-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start; /* Top-aligns text blocks so rows align perfectly */
    align-items: center;
    width: 100%;
  }

  .value-icon-card h3 {
    font-size: 1.25rem;
    font-family: 'Lora', serif;
    font-weight: 600;
    margin-top: 0;
    margin-bottom: 0.75rem; /* Uniform step down to descriptive copy */
    color: #1A334F;
    position: relative;
    display: inline-block;
    text-align: center;
  }

  .value-icon-card h3::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.3rem;
    width: 0%;
    height: 0.15rem;
    background-color: #b27d57;
    transition: width 0.3s ease;
  }

  .value-icon-card:hover h3::after,
  .value-icon-card:focus h3::after {
    width: 100%;
  }

  .value-icon-card p {
    font-size: 0.95rem;
    line-height: 1.4;
    color: #333;
    margin: 0; /* Clear default paragraph drift */
  }


    @keyframes fadeSlideUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
</style>

 <script>
    if (typeof window !== 'undefined') {
      // Animate highlight section (existing)
      const highlightObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('slide-up-in');
            observer.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.5,
        rootMargin: '0px 0px -50px 0px'
      });

      window.addEventListener('DOMContentLoaded', () => {
        const highlightSection = document.querySelector('.highlight-section');
        if (highlightSection) {
          highlightObserver.observe(highlightSection);
        }

        // Animate value icon cards with staggered delay
        const iconCards = document.querySelectorAll('.value-icon-card');
        const iconObserver = new IntersectionObserver((entries, iconObs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              // Add animation with stagger delay based on index
              const index = Array.from(iconCards).indexOf(entry.target);
              entry.target.style.animation = `fadeSlideUp 0.6s ease forwards`;
              entry.target.style.animationDelay = `${index * 150}ms`;
              iconObs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.3 });

        iconCards.forEach(card => iconObserver.observe(card));
      });
    }
  </script>


