<style>

    .announcement-banner {
      background-color: white;
      border: 4px solid #d3e2f2;
      padding: .5rem; /* Increased padding */
      margin: 1rem auto 2rem; /* More vertical spacing */
      max-width: 1000px;
      border-radius: 12px;
      box-shadow: 0 6px 16px rgba(0, 30, 60, 0.3); /* Stronger shadow */
      outline: 2px solid #f72a25;
      outline-offset: 0px;
    }

    .announcement-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: left;
      gap: 1rem; /* Increased gap */
    }

    .announcement-text {
      font-size: 1.15rem; /* Slightly larger */
      color: #1a1a1a;
      margin: 0;
    }

    .announcement-text .highlighted {
      color: #1A334F;
      font-weight: 700; /* Bolder */
    }

.announcement-btn {
  position: relative;
  overflow: hidden;
  background-color: #1a334f;
  color: white;
  border: 0.094rem solid #b27d57;
  text-decoration: none;
  padding: 0.75rem 2.5rem;
  width: 100%;
  border-radius: 8px;
  font-family: 'Lora', serif;
  font-weight: 600;
  text-align: center;
  font-size: 1.05rem;
  box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.4);
  transition: background-color 0.3s ease, transform 0.3s ease;
}



/* Hover effect */
.announcement-btn:hover {
  background-color: #1a334f;
  color: white;
  box-shadow: none;
  transform: translateY(2px);
}


    @media (min-width: 600px) {
      .announcement-content {
        flex-direction: row;
        justify-content: space-between;
        text-align: left;
      }
    }

</style>