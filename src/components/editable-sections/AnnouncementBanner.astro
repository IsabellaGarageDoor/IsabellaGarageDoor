          We look forward to serving our Central Michigan neighbors again when we reopen on January 2nd! 
          Happy Holidays! 🔔
        </p>
      </div>
    </div>
  </section>
)}

{isVisibleNewYears && (
  <section class="announcement-banner reveal-on-scroll">
