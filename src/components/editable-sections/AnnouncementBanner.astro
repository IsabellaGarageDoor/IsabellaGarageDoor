---
// Set these to true to show, false to hide
// General Banners 
const isVisibleGeneralClosed = false;
const isVisibleVacation = false;
const isVisibleBooking = false;

// Birthdays
const isVisibleAmandasBirthday = false;
const isVisiblePetersBirthday = false;
const isVisibleViviansBirthday = false;
const isVisibleLilysBirthday = false;

// Holidays 
const isVisibleMemorialDay = false;
const isVisibleJuly4th = false;
const isVisibleLaborDay = false;
const isVisibleHalloween = false;
const isVisibleThanksgiving = false;
const isVisibleChristmas = false; // Change Dates Yearly
const isVisibleNewYears = false;
---

<!-- GENERAL BANNERS -->

{isVisibleGeneralClosed && (
  <section class="announcement-banner reveal-on-scroll">
    <div class="announcement-content" style="background: linear-gradient(135deg, #1A334F, #334155); padding: 1rem;">
      <div class="announcement-text" style="color: #ffffff;">
        <p>
          <strong>Notice:</strong> Isabella Garage Door will be <strong>closed on Saturday, June 6th</strong>. 
          We appreciate your understanding.
        </p>
      </div>
    </div>
  </section>
)}
     
{isVisibleVacation && (
  <section class="announcement-banner reveal-on-scroll">
    <div class="announcement-content" style="background: linear-gradient(135deg, #0f172a, #0891b2); padding: 1rem;">
      <div class="announcement-text" style="color: #ffffff;">
        <p>
          ✈️ <strong>Notice: Upcoming Scheduled Maintenance</strong> 🏖️<br>
          Isabella Garage Door will be <strong>closed from July 12th – July 21st</strong> for a scheduled family vacation. 
          All inquiries received during this time will be returned in the order they were received starting July 22nd.
        </p>
      </div>
    </div>
  </section>
)}

{isVisibleBooking && (
  <section class="announcement-banner reveal-on-scroll">
    <div class="announcement-content">
      <div class="announcement-text">
        <p>
          📅 <strong>Book Your Service Call</strong> <span class="highlighted"> Online Today</span>!<br>
          Reserve your spot now—slots are limited!<br>
          <em style="color: #b27d57;">Raising Performance. Elevating Standards.</em>
        </p>
      </div>
      <a href="/booking" class="announcement-btn">Book Your Service Call</a>
    </div>
  </section>
)}


