---
// Section wrapper for the coupons. Hidden automatically when no coupon is switched on
// (the on/off switches live at the top of Coupons.astro).
import Coupons from './Coupons.astro';
---

<section class="section section--tight coupons-section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Current Specials</span>
    </div>
    <Coupons />
  </div>
</section>

<style>
  .coupons-section:not(:has(.coupon-bleed)) {
    display: none;
  }

  .section-head {
    margin-bottom: var(--space-6);
  }
</style>
