---
// AskAbel™ inline chat card — embeds the Chatbase assistant.
// Usage: <AskAbelCard /> (optionally with heading/subheading)
import Icon from './ui/Icon.astro';
import { site } from '../config/site';

export interface Props {
  /** @deprecated kept so existing usages compile; the card always embeds the chat */
  chatUrl?: string;
  heading?: string;
  subheading?: string;
}

const {
  heading = 'Still have questions?',
  subheading = 'Ask Abel — our AI assistant — and get an answer in seconds.',
} = Astro.props;
---

<section class="section abel" aria-label="Ask Abel AI assistant">
  <div class="container abel__grid">
    <div class="abel__intro">
      <span class="eyebrow">AskAbel™ AI Assistant</span>
      <h2>{heading}</h2>
      <p>{subheading}</p>
      <a href="/homeowner-tools/ask-abel-ai-assistant" class="link-arrow">
        More about AskAbel™ <Icon name="arrow-right" size="1em" />
      </a>
    </div>

    <div class="abel-card">
      <header class="abel-card__header">
        <div class="abel-card__title">
          <span class="abel-card__avatar"><Icon name="bot" /></span>
          <div>
            <strong>AskAbel™</strong>
            <span>AI Garage Door Assistant · Answers instantly</span>
          </div>
        </div>
        <span class="abel-card__status">
          <span class="abel-card__dot" aria-hidden="true"></span>
          Online
        </span>
      </header>

      <iframe
        src={`https://www.chatbase.co/chatbot-iframe/${site.chatbaseId}`}
        title="Ask Abel — Isabella Garage Door AI Assistant"
        loading="lazy"
        allowtransparency="true"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .abel__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .abel__intro > * + * {
    margin-top: var(--space-4);
  }

  .abel__intro p {
    color: var(--muted);
    font-size: var(--text-lg);
  }

  .abel-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-lg);
  }

  .abel-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--navy);
    color: var(--white);
  }

  .abel-card__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .abel-card__title strong {
    display: block;
    color: var(--white);
  }

  .abel-card__title span:not(.abel-card__avatar) {
    color: rgb(255 255 255 / 0.7);
    font-size: var(--text-xs);
  }

  .abel-card__avatar {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgb(178 125 87 / 0.2);
    color: var(--bronze-300);
  }

  .abel-card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.1);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .abel-card__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 3px rgb(74 222 128 / 0.25);
  }

  .abel-card iframe {
    width: 100%;
    height: 420px;
    border: 0;
    background: var(--white);
  }

  @media (min-width: 900px) {
    .abel__grid {
      grid-template-columns: 1fr 1.25fr;
      gap: var(--space-16);
    }
  }
</style>
