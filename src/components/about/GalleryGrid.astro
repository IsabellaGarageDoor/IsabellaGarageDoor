---
// Job-log photo grid for the gallery pages: client-side pagination (?page=N, #gallery),
// fade-in on scroll (.show) and blur-up once each image has loaded (.loaded).
import Paginate from '../Paginate.astro';

export interface GalleryPost {
  image: string;
  alt: string;
  caption: string;
  /** YYYY-MM-DD */
  date: string;
}

interface Props {
  posts: GalleryPost[];
  perPage?: number;
}

const { posts, perPage = 9 } = Astro.props;
---

<div id="gallery"></div>
<Paginate perPage={perPage} anchor="gallery" class="gallery-grid">
  {posts.map((post) => (
    <figure class="gallery-card">
      <div class="gallery-card__media">
        <img src={post.image} alt={post.alt} loading="lazy" decoding="async" />
      </div>
      <figcaption><p>{post.caption}</p></figcaption>
    </figure>
  ))}
</Paginate>

<style>
  #gallery {
    scroll-margin-top: calc(var(--header-h, 70px) + 1.5rem);
  }

  :global(.gallery-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-6);
  }

  :global(.gallery-grid > [hidden]) {
    display: none;
  }

  .gallery-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease,
      box-shadow var(--duration) var(--ease);
  }

  .gallery-card:hover {
    box-shadow: var(--shadow-lg);
  }

  :global(.js) .gallery-card:not(.show) {
    opacity: 0;
    transform: translateY(20px);
  }

  .gallery-card__media {
    overflow: hidden;
  }

  .gallery-card img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition:
      filter 0.5s ease,
      transform 0.3s ease;
  }

  :global(.js) .gallery-card img:not(.loaded) {
    filter: blur(8px);
  }

  .gallery-card:hover img {
    transform: scale(1.025);
  }

  .gallery-card figcaption {
    flex: 1;
    padding: var(--space-5) var(--space-6) var(--space-6);
    border-top: 3px solid var(--bronze-100);
  }

  .gallery-card p {
    color: var(--ink);
    font-family: var(--font-heading);
    font-style: italic;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-card,
    .gallery-card img {
      transition: none;
    }
  }
</style>

<script>
  // Fade each card in as it scrolls into view (once)
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('show');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('.gallery-card').forEach((card) => observer.observe(card));

  // Remove the blur once each photo has loaded
  document.querySelectorAll<HTMLImageElement>('.gallery-card img').forEach((img) => {
    if (img.complete) {
      img.classList.add('loaded');
    } else {
      img.addEventListener('load', () => img.classList.add('loaded'));
    }
  });
</script>
