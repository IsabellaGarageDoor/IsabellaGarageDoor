<!-- Homeowner toolbox -->
<section class="core-services-section">
  <div class="homeowner-toolbox-section">
    <h2 class="sub-heading">Homeowner Toolbox</h2>
     <p style="text-align: left;">Fast answers. Instant estimates. Easy diagnostics. Built for you.</p>

    <div class="homeowner-toolbox-wrapper">
      <div class="homeowner-toolbox-grid">

        <a href="/homeowner-tools/easy-estimate#estimate-form" aria-label="Receive a Free Estimate from Isabella Garage Door" class="homeowner-toolbox-card">
          <img src="/photos/easyestimate-logo.webp" alt="EasyEstimate" class="homeowner-toolbox-img">
          <div class="homeowner-toolbox-body">
            <h3>EasyEstimate™</h3>
            <p>Curious about costs? EasyEstimate™ gives fast estimates in seconds.</p>
        <p class="read-more" style="color: #b27d57;">Get Estimate →</p>
          </div>
        </a>

        <a href="/homeowner-tools/door-diagnosis#troubleshooting" aria-label="Diagnose Your Garage Door with DoorDiagnosis Tool" class="homeowner-toolbox-card">
          <img src="/photos/doordiagnosis-logo.webp" alt="DoorDiagnosis" class="homeowner-toolbox-img">
          <div class="homeowner-toolbox-body">
            <h3>DoorDiagnosis™</h3>
            <p>Door problems? DoorDiagnosis™ pinpoints the problem in less than a minute.</p>
        <p class="read-more" style="color: #b27d57;">Find Problem →</p>
          </div>
        </a>

        <a href="/homeowner-tools/spring-status#springstatus" aria-label="Check Your Garage Door Springs with SpringStatus Tool" class="homeowner-toolbox-card">
          <img src="/photos/springstatus-logo.webp" alt="SpringStatus" class="homeowner-toolbox-img">
          <div class="homeowner-toolbox-body">
            <h3>SpringStatus™</h3>
            <p>Worried your springs might fail? SpringStatus™ calculates their lifespan instantly—so you know when to replace them.</p>
        <p class="read-more" style="color: #b27d57;">Check Springs →</p>
          </div>
        </a>

        <a href="/homeowner-tools/ask-abel-ai-assistant#askabel" aria-label="AI Garage Door Chat Bot" class="homeowner-toolbox-card">
          <img src="/photos/askabel-logo.webp" alt="AI Garage Door Assistant" class="homeowner-toolbox-img">
          <div class="homeowner-toolbox-body">
            <h3>AskAbel™</h3>
            <p>Got a garage door question? AskAbel™ gives you instant answers—anytime, day or night</p>
        <p class="read-more" style="color: #b27d57;">Ask Abel →</p>
          </div>
        </a>
   

      </div>
    </div>

