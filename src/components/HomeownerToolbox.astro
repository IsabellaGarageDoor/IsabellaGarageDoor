---
// Homeowner Toolbox: the four free tools (EasyEstimate, DoorDiagnosis, SpringStatus, AskAbel).
import Icon from './ui/Icon.astro';

interface Props {
  heading?: string;
}
const { heading = 'Homeowner Toolbox' } = Astro.props;

const tools = [
  {
    href: '/homeowner-tools/easy-estimate#estimate-form',
    label: 'Receive a Free Estimate from Isabella Garage Door',
    img: '/photos/easy-estimate-logo.avif',
    alt: 'EasyEstimate',
    name: 'EasyEstimate™',
    text: 'Curious about costs? EasyEstimate™ gives fast estimates in seconds.',
    cta: 'Get Estimate',
  },
  {
    href: '/homeowner-tools/door-diagnosis#troubleshooting',
    label: 'Diagnose Your Garage Door with DoorDiagnosis Tool',
    img: '/photos/door-diagnosis-logo.avif',
    alt: 'DoorDiagnosis',
    name: 'DoorDiagnosis™',
    text: 'Door problems? DoorDiagnosis™ pinpoints the problem in less than a minute.',
    cta: 'Find Problem',
  },
  {
    href: '/homeowner-tools/spring-status#springstatus',
    label: 'Check Your Garage Door Springs with SpringStatus Tool',
    img: '/photos/spring-status-logo.avif',
    alt: 'SpringStatus',
    name: 'SpringStatus™',
    text: 'Worried your springs might fail? SpringStatus™ calculates their lifespan instantly—so you know when to replace them.',
    cta: 'Check Springs',
  },
  {
    href: '/homeowner-tools/ask-abel-ai-assistant#askabel',
    label: 'AI Garage Door Chat Bot',
    img: '/photos/askabel-robot-head-logo.avif',
    alt: 'AI Garage Door Assistant',
    name: 'AskAbel™',
    text: 'Got a garage door question? AskAbel™ gives you instant answers—anytime, day or night',
    cta: 'Ask Abel',
  },
];
---

<section class="section section--sand toolbox">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Free Tools</span>
      <h2>{heading}</h2>
      <p>Fast answers. Instant estimates. Easy diagnostics. Built for you.</p>
    </div>

    <div class="grid grid--4">
      {tools.map((t) => (
        <a href={t.href} class="card card--link toolbox__card reveal" aria-label={t.label}>
          <img src={t.img} alt={t.alt} class="toolbox__logo" loading="lazy" width="160" height="64" />
          <h3>{t.name}</h3>
          <p>{t.text}</p>
          <span class="link-arrow card__more">{t.cta} <Icon name="arrow-right" size="1em" /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .toolbox__logo {
    width: auto;
    height: 56px;
    object-fit: contain;
    object-position: left center;
  }

  .toolbox__card h3 {
    margin-top: var(--space-5);
  }
</style>
