---
// Client-side blog search over /search.json (built by src/pages/search.json.ts).
import Icon from './ui/Icon.astro';
---

<div class="search">
  <div class="search__field">
    <Icon name="search" class="search__icon" />
    <input
      id="article-search-input"
      class="search__input"
      type="search"
      placeholder="Search articles (springs, rollers, openers...)"
      aria-label="Search articles"
      aria-controls="article-search-results"
      autocomplete="off"
    />
  </div>

  <ul id="article-search-results" class="results" aria-live="polite"></ul>
</div>

<script>
  const input = document.getElementById('article-search-input') as HTMLInputElement | null;
  const results = document.getElementById('article-search-results');

  type Article = { title: string; description: string; slug: string; thumbnail: string; content: string };
  let articles: Article[] = [];

  /** Escape text before it goes into innerHTML (titles/descriptions are not trusted as HTML). */
  const escapeHtml = (value: unknown) =>
    String(value ?? '').replace(/[&<>"']/g, (ch) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch] as string
    );

  function render() {
    if (!input || !results) return;
    const query = input.value.toLowerCase().trim();
    results.innerHTML = '';

    if (!query) return;

    const matches = articles
      .map((article) => {
        let score = 0;

        const title = (article.title || '').toLowerCase();
        const description = (article.description || '').toLowerCase();
        const content = (article.content || '').toLowerCase();

        if (title.includes(query)) score += 100;
        if (description.includes(query)) score += 40;
        if (content.includes(query)) score += 10;

        return { ...article, score };
      })
      .filter((article) => article.score > 0)
      .sort((a, b) => b.score - a.score);

    if (matches.length === 0) {
      results.innerHTML = '<li class="results__empty">No results found</li>';
      return;
    }

    for (const article of matches) {
      const li = document.createElement('li');
      const title = escapeHtml(article.title || 'Untitled Article');
      li.innerHTML = `
        <a href="/blog/${escapeHtml(article.slug)}" class="result-item">
          ${article.thumbnail ? `
            <img
              src="${escapeHtml(article.thumbnail)}"
              alt="${escapeHtml(article.title || 'Article thumbnail')}"
              loading="lazy"
            />
          ` : ''}

          <div class="result-text">
            <strong>${title}</strong>
            <small>${escapeHtml(article.description || '')}</small>
          </div>
        </a>
      `;

      results.appendChild(li);
    }
  }

  fetch('/search.json')
    .then((res) => res.json())
    .then((data) => {
      articles = data;
      // Show results for anything typed before the index finished loading
      render();
    });

  input?.addEventListener('input', render);
</script>

<style>
  .search {
    width: 100%;
  }

  .search__field {
    position: relative;
    max-width: 44rem;
    margin-inline: auto;
  }

  .search__field :global(.search__icon) {
    position: absolute;
    top: 50%;
    left: 1.1rem;
    color: var(--bronze-600);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .search__input {
    width: 100%;
    min-height: 58px;
    padding: 0.85rem 1.25rem 0.85rem 3.25rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--white);
    box-shadow: var(--shadow);
    color: var(--ink);
    font-size: var(--text-lg);
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }

  .search__input::placeholder {
    color: #8a94a1;
  }

  .search__input:focus {
    outline: none;
    border-color: var(--bronze-600);
    box-shadow: 0 0 0 3px rgb(154 103 68 / 0.25), var(--shadow);
  }

  .results {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-10);
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }

  .results :global(li) {
    display: flex;
  }

  .results :global(.results__empty) {
    grid-column: 1 / -1;
    justify-content: center;
    padding: var(--space-8);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    color: var(--muted);
    text-align: center;
  }

  .results :global(.result-item) {
    display: flex;
    flex: 1;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    transition:
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .results :global(.result-item:hover) {
    color: inherit;
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  .results :global(.result-item img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--sand);
  }

  .results :global(.result-text) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
  }

  .results :global(.result-text strong) {
    color: var(--navy);
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: var(--leading-snug);
  }

  .results :global(.result-text small) {
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
