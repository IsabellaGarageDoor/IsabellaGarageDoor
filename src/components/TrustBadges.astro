---
// Six trust badges (insured, technicians, parts, local, warranty, rated).
import { Image } from 'astro:assets';
import shieldImg from '../assets/images/trust-badge-shield.avif';
import toolsImg from '../assets/images/trust-badge-tools.avif';
import gearsImg from '../assets/images/trust-badge-gears.avif';
import michiganImg from '../assets/images/trust-badge-michigan.avif';
import bannerImg from '../assets/images/trust-badge-banner.avif';
import starsImg from '../assets/images/trust-badge-stars.avif';

interface Props {
  /** "light" for cream/white backgrounds, "dark" for navy/photo backgrounds */
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;

const badges = [
  { img: shieldImg, alt: 'Fully Insured', label: ['Fully', 'Insured'] },
  { img: toolsImg, alt: 'Expert Technicians', label: ['Expert', 'Technicians'] },
  { img: gearsImg, alt: 'Premium Parts', label: ['Premium', 'Parts'] },
  { img: michiganImg, alt: 'Local-Family Owned', label: ['Local-Family', 'Owned'] },
  { img: bannerImg, alt: 'Warranty Guarantee', label: ['Warranty', 'Guarantee'] },
  { img: starsImg, alt: '5 Star Rated', label: ['5 Star', 'Rated'] },
];
---

<ul class:list={['trust-badges', `trust-badges--${tone}`]}>
  {badges.map((b) => (
    <li class="trust-badge">
      <Image src={b.img} alt="" width={140} height={140} />
      <p>{b.label[0]}<br />{b.label[1]}</p>
    </li>
  ))}
</ul>

<style>
  .trust-badges {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5) var(--space-3);
    max-width: 1000px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .trust-badge img {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--space-2);
    filter: drop-shadow(0 4px 8px rgb(17 35 56 / 0.18));
  }

  .trust-badge p {
    color: var(--navy);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.3;
  }

  .trust-badges--dark .trust-badge p {
    color: rgb(255 255 255 / 0.92);
  }

  @media (min-width: 720px) {
    .trust-badges {
      grid-template-columns: repeat(6, 1fr);
    }

    .trust-badge img {
      width: 72px;
      height: 72px;
    }
  }
</style>
