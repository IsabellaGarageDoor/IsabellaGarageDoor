---
// Google Map of the service area plus links to every location page.
import { locations } from '../data/locations';

interface Props {
  title?: string;
  height?: string;
}
const { title = 'Our Service Area', height = '420px' } = Astro.props;
const towns = locations.filter((l) => l.kind === 'town');
---

<section class="section section--white service-area" id="service-area">
  <div class="container service-area__grid">
    <div class="service-area__text">
      <span class="eyebrow">Where We Work</span>
      <h2>{title}</h2>
      <p class="lead">
        Looking for garage door services near you? Isabella Garage Door proudly serves homeowners in:
      </p>
      <ul class="service-area__list">
        {towns.map((t) => <li><a href={t.href} class="chip">{t.name === 'Mt. Pleasant' ? 'Mount Pleasant' : t.name}</a></li>)}
      </ul>
      <p>
        …and surrounding <a href="/locations/central-michigan">Central Michigan</a> communities.
      </p>
    </div>

    <figure class="service-area__map">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d369828.344646622!2d-85.19637064728467!3d43.60062923509618!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8aadaa53b2adce97%3A0x3913aebf0ae0b1fe!2sIsabella%20Garage%20Door!5e0!3m2!1sen!2sus!4v1778481566879!5m2!1sen!2sus"
        style={`height: ${height}`}
        title="Map of the Isabella Garage Door service area in Central Michigan"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
      <figcaption class="service-area__note">
        The map above is intended as a general service reference. If you're located nearby but outside the highlighted area,
        please contact us to discuss availability.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .service-area__grid {
    display: grid;
    gap: var(--space-10);
    align-items: center;
  }

  .service-area__text > * + * {
    margin-top: var(--space-5);
  }

  .service-area__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .service-area__note {
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .service-area__map iframe {
    width: 100%;
    border: 0;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 960px) {
    .service-area__grid {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-16);
    }
  }
</style>
