---
// Full-width photo hero for the homepage and location pages.
// The photo goes in the "image" slot (SeasonalHeroImage on the homepage,
// a <picture> on location pages).
import Icon from './ui/Icon.astro';
import { site, telHref, smsHref, smsMessages } from '../config/site';

interface Props {
  title: string;
  description: string;
  bullets: string[];
  eyebrow?: string;
}

const { title, description, bullets, eyebrow = 'Locally owned · Rosebush, Michigan' } = Astro.props;
---

<section class="home-hero">
  <div class="home-hero__media">
    <slot name="image" />
  </div>
  <div class="home-hero__overlay" aria-hidden="true"></div>

  <div class="container container--wide home-hero__content">
    <div class="home-hero__text">
      <span class="eyebrow">{eyebrow}</span>
      <h1 set:html={title} />
      <p class="home-hero__desc" set:html={description} />
      <ul class="check-list home-hero__bullets">
        {bullets.map((b) => (
          <li><Icon name="check-circle" /> <span set:html={b} /></li>
        ))}
      </ul>
      <div class="cluster home-hero__actions">
        <a href={telHref} class="btn btn--primary btn--lg">
          <Icon name="phone" /> Call {site.phone.display}
        </a>
        <a href={smsHref(smsMessages.general)} class="btn btn--outline-light btn--lg">
          <Icon name="text" /> Text Us
        </a>
      </div>
      <div class="home-hero__links">
        <a href="/booking" class="link-arrow">Book online <Icon name="arrow-right" size="1em" /></a>
        <span class="home-hero__links-sep" aria-hidden="true"></span>
        <span>Not sure what it'll cost?{' '}
          <a href="/homeowner-tools/easy-estimate#estimate-form" class="link-arrow">Get an Instant Estimate <Icon name="arrow-right" size="1em" /></a>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: min(88vh, 760px);
    overflow: hidden;
    background: var(--navy-900);
    color: rgb(255 255 255 / 0.9);
  }

  .home-hero__media,
  .home-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .home-hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .home-hero__overlay {
    background:
      linear-gradient(90deg, rgb(12 26 42 / 0.92) 0%, rgb(12 26 42 / 0.78) 38%, rgb(12 26 42 / 0.25) 75%, rgb(12 26 42 / 0.1) 100%),
      linear-gradient(0deg, rgb(12 26 42 / 0.55) 0%, transparent 35%);
  }

  .home-hero__content {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem);
  }

  .home-hero__text {
    max-width: 40rem;
  }

  .home-hero__text > * + * {
    margin-top: var(--space-5);
  }

  .home-hero .eyebrow {
    color: var(--bronze-300);
  }

  .home-hero h1 {
    color: var(--white);
    font-size: clamp(2.2rem, 1.5rem + 3vw, 3.75rem);
  }

  .home-hero__desc {
    font-size: var(--text-xl);
    line-height: 1.5;
  }

  .home-hero__bullets {
    gap: var(--space-2);
  }

  .home-hero__bullets :global(.icon) {
    color: var(--bronze-300);
  }

  .home-hero__actions {
    padding-top: var(--space-2);
  }

  .home-hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    font-size: var(--text-sm);
  }

  .home-hero__links .link-arrow {
    color: var(--bronze-300);
  }

  .home-hero__links .link-arrow:hover {
    color: var(--white);
  }

  .home-hero__links-sep {
    width: 1px;
    height: 1.2em;
    background: rgb(255 255 255 / 0.3);
  }

  @media (max-width: 719px) {
    .home-hero {
      min-height: 0;
    }

    .home-hero__overlay {
      background: linear-gradient(180deg, rgb(12 26 42 / 0.75) 0%, rgb(12 26 42 / 0.88) 100%);
    }

    .home-hero__actions :global(.btn) {
      width: 100%;
    }

    .home-hero__links-sep {
      display: none;
    }
  }
</style>
