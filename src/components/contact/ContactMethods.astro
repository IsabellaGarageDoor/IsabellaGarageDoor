---
// "Prefer to call or text?" panel: voice / mobile / inbox rows.
// The hrefs are passed through exactly as each page had them.
import Icon from '../ui/Icon.astro';

interface Props {
  heading?: string;
  /** sms: link with this page's pre-filled message */
  sms: string;
  /** Use a heading level that fits the page outline */
  headingLevel?: 'h2' | 'h3';
}

const { heading, sms, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;

const rows = [
  { method: 'VOICE', label: '989-572-0303', href: 'tel:+19895720303', icon: 'phone' },
  { method: 'MOBILE', label: 'Text a Technician', href: sms, icon: 'text' },
  { method: 'INBOX', label: 'Email the Office', href: 'mailto:isabellagaragedoor@gmail.com', icon: 'mail' },
];
---

<div class="contact-methods">
  {heading && <Heading class="contact-methods__heading">{heading}</Heading>}
  <ul class="contact-methods__list">
    {rows.map((r) => (
      <li>
        <a href={r.href} class="contact-methods__row">
          <span class="contact-methods__icon"><Icon name={r.icon} /></span>
          <span class="contact-methods__text">
            <span class="contact-methods__method">{r.method}</span>
            <span class="contact-methods__label">{r.label}</span>
          </span>
          <Icon name="chevron-right" class="contact-methods__chev" />
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .contact-methods__heading {
    margin-bottom: var(--space-5);
    font-size: var(--h3);
  }

  .contact-methods__list {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .contact-methods__row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    color: var(--navy);
    text-decoration: none;
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .contact-methods__row:hover {
    border-color: var(--bronze-200);
    box-shadow: var(--shadow);
    color: var(--navy);
    transform: translateY(-1px);
  }

  .contact-methods__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--bronze-100);
    color: var(--bronze-700);
  }

  .contact-methods__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }

  .contact-methods__method {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .contact-methods__label {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .contact-methods__row :global(.contact-methods__chev) {
    flex-shrink: 0;
    color: var(--bronze-600);
  }
</style>
