---
// Three article cards from the blog. Every post is rendered; the newest COUNT show
// by default and the browser picks COUNT at random on each visit
// (see src/scripts/random-pick.ts).
import { getCollection } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
import Icon from './ui/Icon.astro';

const COUNT = 3;
const posts = await getCollection('blog');
const featuredPosts = [...posts].sort(
  (a, b) => new Date(b.data.pubDate ?? 0).getTime() - new Date(a.data.pubDate ?? 0).getTime()
);
---

<section class="section blog-teaser">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">From the Blog</span>
      <h2>Garage Door Tips & Learning Center</h2>
    </div>

    <div class="blog-cards grid grid--3 reveal" data-random-pick={COUNT}>
      {featuredPosts.map((post, i) => (
        <ArticleCard post={post} hidden={i >= COUNT} />
      ))}
    </div>

    <div class="cluster cluster--center mt-10">
      <a href="/resources/learning-center" class="btn btn--outline">
        Visit the Learning Center <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</section>

<script>
  import '../scripts/random-pick';
</script>
