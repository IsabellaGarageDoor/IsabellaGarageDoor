---
// "Ready to Get Your Door Fixed?" call-to-action band.
import Icon from './ui/Icon.astro';
import { site, telHref } from '../config/site';
---

<section class="booking-cta">
  <div class="container booking-cta__inner reveal">
    <div class="booking-cta__text">
      <h2>Ready to Get Your Door Fixed?</h2>
      <p>
        Book a service call online in minutes — pick a time that works for you and we'll take
        care of the rest. Most repairs are completed the same visit.
      </p>
    </div>
    <div class="booking-cta__actions">
      <a href="/booking#book-online" class="btn btn--primary btn--lg">
        <Icon name="calendar" /> Schedule a Service Call
      </a>
      <a href={telHref} class="btn btn--outline-light btn--lg">
        <Icon name="phone" /> Call {site.phone.display}
      </a>
      <p class="booking-cta__sub">Need help today? Call or text for an immediate response.</p>
    </div>
  </div>
</section>

<style>
  .booking-cta {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 3vw, 4.5rem);
    background:
      radial-gradient(circle at 85% 20%, rgb(178 125 87 / 0.22), transparent 45%),
      linear-gradient(135deg, var(--navy-800), var(--navy));
    color: rgb(255 255 255 / 0.85);
  }

  .booking-cta__inner {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .booking-cta h2 {
    color: var(--white);
  }

  .booking-cta__text p {
    max-width: 38rem;
    margin-top: var(--space-4);
    font-size: var(--text-lg);
  }

  .booking-cta__actions {
    display: grid;
    gap: var(--space-3);
  }

  .booking-cta__sub {
    color: rgb(255 255 255 / 0.7);
    font-size: var(--text-sm);
    text-align: center;
  }

  @media (min-width: 900px) {
    .booking-cta__inner {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-12);
    }
  }
</style>
