---

<section class="booking-cta-section reveal-on-scroll">
  <h2 class="sub-heading">Ready to Get Your Door Fixed?</h2>
  <p class="booking-cta-text">
    Book a service call online in minutes — pick a time that works for you and we'll take
    care of the rest. Most repairs are completed the same visit.
  </p>
  <div class="booking-cta-buttons">
    <a href="/booking" class="testimonials-cta-button" style="margin-bottom: 1rem;">
      <i class="fa-solid fa-calendar-check fa-fw"></i> Schedule a Service Call
    </a>
    <a href="tel:9895720303" class="cta-button-secondary">
      <i class="fa-solid fa-phone fa-fw"></i> Call (989) 572-0303
    </a>
  </div>
  <p class="booking-cta-subtext">
    Need help today? Call or text for an immediate response.
  </p>
</section>

<style>
.booking-cta-section {
  text-align: center;
  padding: 2.5rem 1.5rem;
  margin: 1rem auto 2rem;
  max-width: 800px;
  background: #1a334f;
  border: 0.194rem solid #b27d57;
  border-radius: 0.75rem;
  box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.4);
}

.booking-cta-section:hover,
.booking-cta-section:focus {
  box-shadow: 0 0 0.75rem rgba(178, 125, 87, 0.5);
  outline: none;
}

  /* Radial overlay */
  .booking-cta-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top left, rgba(255,255,255,0.1), transparent 80%);
    z-index: 0;
    pointer-events: none;
  }

.booking-cta-section h2 {
  color: #ffffff;
}

.booking-cta-text {
  font-size: 1.05rem;
  color: #ffffff;
  margin: 0.75rem auto 1.5rem;
  max-width: 520px;
  line-height: 1.6;
}

.booking-cta-buttons {
  display: inline-block;
  flex-wrap: wrap;
  gap: 1rem;
  justify-content: center;
  margin-bottom: 1rem;
}

.cta-button-secondary {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  border: 2px solid #ffffff;
  border-radius: 0.5rem;
  color: #ffffff;
  font-weight: 600;
  font-size: 1rem;
  text-decoration: none;
  transition: background 0.2s ease, color 0.2s ease;
}

.cta-button-secondary:hover {
  background: #ffffff;
  color: #1a334f;
}

.booking-cta-subtext {
  font-size: 0.875rem;
  color: #fff;
  margin-top: 0.5rem;
}

/* Base styles for the button */
.book-now-btn {
  display: inline-block;
  background-color: #e63946; /* High-contrast Crimson Red */
  color: #ffffff; /* White text for readability */
  font-family: Arial, sans-serif; /* Replace with your brand font */
  font-size: 18px;
  font-weight: bold;
  text-transform: uppercase;
  text-decoration: none;
  padding: 16px 32px;
  border-radius: 8px; /* Slightly rounded corners */
  border: 2px solid #f72a25;
  box-shadow: 0 4px 6px rgba(26, 51, 79, 0.2); /* Shadow subtly uses your brand blue */
  transition: all 0.3s ease-in-out;
  cursor: pointer;
  text-align: center;
}

/* Hover and Focus states for interactivity */
.book-now-btn:hover,
.book-now-btn:focus {
  background-color: #ffffff; 
  color: #e63946; /* Inverts the colors on hover */
  box-shadow: 0 6px 12px rgba(26, 51, 79, 0.3); /* Deeper shadow on hover */
  transform: translateY(-2px); /* Slight lift effect */
}

/* Active state for when the button is clicked */
.book-now-btn:active {
  transform: translateY(0); /* Pushes the button back down */
  box-shadow: 0 2px 4px rgba(26, 51, 79, 0.2);
}

</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const cards = document.querySelectorAll(".homeowner-toolbox-card, .core-services-card, .reveal-on-scroll");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target); // reveal once
          }
        });
      },
      {
        threshold: 0.2, // trigger when 20% of card is visible
      }
    );

    cards.forEach((card) => {
      observer.observe(card);
    });
  });
</script>