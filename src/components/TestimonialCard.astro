---
// A single customer review, optionally linking to the testimonials page.
interface Props {
  quote: string;
  author: string;
  rating?: number; // Optional, defaults to 5
  /** Wrap the card in a link (most pages link to /about/testimonials) */
  href?: string;
}

const { quote, author, rating = 5, href } = Astro.props;
const Tag = href ? 'a' : 'figure';
---

<Tag class:list={['review-card', { 'review-card--link': href }]} href={href}>
  <div class="review-card__stars" aria-label={`${rating} out of 5 stars`}>
    {Array.from({ length: 5 }).map((_, i) => (
      <svg viewBox="0 0 20 20" class:list={['star', i < rating ? 'filled' : 'empty']} aria-hidden="true" width="20" height="20">
        <polygon points="10,1.5 12.6,7.4 18.9,7.4 13.9,11.4 15.7,17.5 10,13.8 4.3,17.5 6.1,11.4 1.1,7.4 7.4,7.4" />
      </svg>
    ))}
  </div>
  <blockquote class="review-card__quote" set:html={quote} />
  <p class="review-card__author">— {author}</p>
</Tag>

<style>
  .review-card {
    position: relative;
    display: block;
    max-width: 760px;
    margin-inline: auto;
    padding: var(--space-8) var(--space-8) var(--space-6);
    border: 1px solid var(--line);
    border-left: 4px solid var(--bronze);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
  }

  .review-card::after {
    content: '\201D';
    position: absolute;
    top: 0.5rem;
    right: 1.5rem;
    color: var(--bronze-100);
    font-family: var(--font-heading);
    font-size: 6rem;
    line-height: 1;
    pointer-events: none;
  }

  .review-card--link {
    transition: box-shadow var(--duration) var(--ease), transform var(--duration) var(--ease);
  }

  .review-card--link:hover {
    color: inherit;
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .review-card__stars {
    display: flex;
    gap: 2px;
  }

  .star.filled {
    fill: var(--bronze);
  }

  .star.empty {
    fill: var(--line);
  }

  .review-card__quote {
    position: relative;
    margin-top: var(--space-4);
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.6;
  }

  .review-card__author {
    margin-top: var(--space-4);
    color: var(--navy);
    font-weight: 600;
  }
</style>
