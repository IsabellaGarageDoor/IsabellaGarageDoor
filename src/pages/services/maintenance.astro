const content: Omit<ServicePageContent, 'schema'> = {
  title: title,
  description: description,
  crumb: {
    name: "Garage Door Maintenance",
    href: "/services/maintenance"
  },
  hero: {
    title: "Is Your Garage Door in Need Of Maintenance?",
    image: "/photos/maintenance-on-a-garage-door-clare-michigan.avif",
    imageAlt: "Maintaining a garage door in Clare Michigan",
    paragraphs: [
      "Prevent breakdowns. Extend system life. Protect your investment.",
      "Your garage door is the largest moving system in your home — and one of the most used. Professional maintenance catches small issues before they become expensive failures and keeps your system operating safely and reliably."
    ],
    callout: "<strong>In need of garage door maintenance?</strong> Call or text us today.",
    smsHref: "sms:+19895720303?&body=Hi%2C%20I'm%20interested%20in%20a%20new%20garage%20door."
  },
  faq: {
    items: [
      {
        question: "How often should I have my garage door professionally serviced?",
        answer: "<p>Most residential garage doors should be professionally serviced at least once per year. If you use your door heavily (multiple times per day), have an older system (15+ years), or notice any unusual sounds or behavior, twice-per-year maintenance is recommended. Annual maintenance catches wear before it leads to expensive breakdowns.</p>"
      },
      {
        question: "What does garage door maintenance include?",
        answer: "<p>Our maintenance service includes a full mechanical inspection of springs, cables, rollers, hinges, and tracks; professional lubrication of all moving parts; door balance testing and adjustment; safety system testing (photo eyes and auto-reverse); opener force and travel checks; and a written condition report identifying any components that need attention. The goal is to catch small issues before they become failures.</p>"
      },
      {
        question: "Can I do garage door maintenance myself?",
        answer: "<p>You can handle basic maintenance like cleaning tracks, checking for obstructions, and visual inspections. However, spring tension testing, cable inspection, door balancing, and safety system calibration require professional tools and expertise. Springs are under extreme tension and can cause serious injury if handled improperly. We recommend DIY for basic cleaning and visual checks, but professional service annually for thorough inspection and adjustment. Check out our <a href=\"/blog/diy-garage-door-maintenance-tips\">DIY maintenance guide</a> for what you can safely do yourself.</p>"
      },
      {
        question: "What are signs my garage door needs maintenance?",
        answer: "<p>Common signs include the door being louder than usual, jerky or shaky movement, the opener struggling to lift the door, visible rust on cables or springs, the door feeling heavy when lifted manually, squeaking or grinding noises, or if you simply can't remember the last time it was serviced. Any change in how your door operates is worth having professionally inspected.</p>"
      },
      {
        question: "Will maintenance prevent my garage door from breaking?",
        answer: "<p>While maintenance can't prevent all failures (garage door springs have a finite lifespan measured in cycles), it dramatically reduces unexpected breakdowns. Regular maintenance catches worn components before they fail, keeps the system properly balanced to reduce strain, and ensures safety features are working correctly. Most emergency service calls we receive are from doors that haven't been maintained in years.</p>"
      }
    ]
  },
  research: {
    heading: "Want to learn more about maintaining your garage door?",
    text: "We’ve written a brief article on maintenance you can do yourself and why its important to your garage doors function and lifespan.",
    post: {
      image: "/photos/thumbnails/garage-door-5.webp",
      imageAlt: "Garage door Maintenance tips for Isabella County Homeowners",
      title: "5 Simple DIY Garage Door Maintenance Tips",
      titleHref: "/blog/diy-garage-door-maintenance-tips",
      excerpt: "Your garage door is the largest moving part of your home-and one of the hardest working. With regular use, it's easy to overlook small issues that can turn into big problems. But with just a little attention a few times a year, you can keep your door running smoothly and avoid unnecessary repairs."
    }
  },
  cta: {
    label: "Schedule Maintenance Today"
  },
  signoff: "Prevent problems before they start—trusted garage door maintenance across Central Michigan."
};
---

<ServicePage {...content} schema={[maintenanceSchema]}>
  <ServiceSection heading={"Why Garage Door Maintenance Matters"}>
    <p> Most garage door failures don’t happen suddenly. They build over time from wear, friction, and unnoticed part fatigue. Routine inspection and adjustment prevents broken springs, snapped cables, door-off-track situations, and premature opener failure. </p>
    <ul><li>High-tension springs under extreme pressure</li><li>Cables carrying the full weight of the door</li><li>Rollers, hinges, and bearings that wear with every cycle</li><li>Safety systems that protect your family</li><li>An opener that depends on a properly balanced door</li></ul>
  </ServiceSection>

  <ServiceHighlights heading={"What Our Maintenance Service Includes"} items={[{"title":"Full Mechanical Inspection","body":"<ul><li>Springs checked for wear, stretch, and balance</li><li>Cables inspected for fraying, rust, and tension</li><li>Rollers checked for worn bearings</li><li>Hinges inspected for cracking or fatigue</li><li>Track alignment and fastener inspection</li></ul>"},{"title":"Door Balance &amp; Operation Test","body":"<ul><li>Professional door balance test</li><li>Minor spring adjustment if needed</li><li>Manual operation test</li><li>Opener force and travel check</li></ul>"},{"title":"Safety System Testing","body":"<ul><li>Photo eye sensor alignment and test</li><li>Auto-reverse pressure test</li><li>Emergency release check</li></ul>"},{"title":"Professional Lubrication","body":"<p> Proper lubrication at the correct points using professional-grade products designed specifically for garage door systems. </p>"},{"title":"Condition Report","body":"<p> You receive a clear report of component condition: <strong>Good / Fair / Poor</strong>, so you can make informed decisions before failures occur. </p>"}]} tone="sand" />

  <ServiceSection heading={"How Often Should a Garage Door Be Maintained?"}>
    <p> Most homes should have their garage door inspected at least once per year. High-use or older systems benefit from twice-per-year inspections. </p>
  </ServiceSection>

  <ServiceSection heading={"Signs Your Door Is Overdue for Maintenance"} tone="sand">
    <ul><li>Door is louder than it used to be</li><li>Jerky or shaky movement</li><li>Opener struggling to lift the door</li><li>Rust on cables or springs</li><li>Door feels heavy when lifted manually</li><li>You can’t remember the last service</li></ul>
  </ServiceSection>
</ServicePage>
