  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Garage Door Maintenance",
  "provider": {
    "@id": "https://isabellagaragedoor.com/#business"
  },
  "description": "Comprehensive preventative maintenance for residential garage doors to ensure safe, quiet, and reliable operation.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Maintenance Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Hardware Inspection",
          "description": "A thorough check of springs, cables, rollers, and sensors to identify wear before it leads to failure."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Lubrication & Adjustment",
          "description": "Professional-grade lubrication of all moving parts and precision door balancing to reduce motor strain."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Opener Safety Test",
          "description": "Testing the auto-reverse and photo-eye sensors to ensure your door meets modern safety standards."
        }
      }
    ]
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How often should I have my garage door professionally serviced?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most residential garage doors should be professionally serviced at least once per year. If you use your door heavily (multiple times per day), have an older system (15+ years), or notice any unusual sounds or behavior, twice-per-year maintenance is recommended. Annual maintenance catches wear before it leads to expensive breakdowns."
      }
    },
    {
      "@type": "Question",
      "name": "What does garage door maintenance include?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our maintenance service includes a full mechanical inspection of springs, cables, rollers, hinges, and tracks; professional lubrication of all moving parts; door balance testing and adjustment; safety system testing (photo eyes and auto-reverse); opener force and travel checks; and a written condition report identifying any components that need attention. The goal is to catch small issues before they become failures."
      }
    },
    {
      "@type": "Question",
      "name": "Can I do garage door maintenance myself?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can handle basic maintenance like cleaning tracks, checking for obstructions, and visual inspections. However, spring tension testing, cable inspection, door balancing, and safety system calibration require professional tools and expertise. Springs are under extreme tension and can cause serious injury if handled improperly. We recommend DIY for basic cleaning and visual checks, but professional service annually for thorough inspection and adjustment."
      }
    },
    {
      "@type": "Question",
      "name": "What are signs my garage door needs maintenance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Common signs include the door being louder than usual, jerky or shaky movement, the opener struggling to lift the door, visible rust on cables or springs, the door feeling heavy when lifted manually, squeaking or grinding noises, or if you simply can't remember the last time it was serviced. Any change in how your door operates is worth having professionally inspected."
      }
    },
    {
      "@type": "Question",
      "name": "Will maintenance prevent my garage door from breaking?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "While maintenance can't prevent all failures (garage door springs have a finite lifespan measured in cycles), it dramatically reduces unexpected breakdowns. Regular maintenance catches worn components before they fail, keeps the system properly balanced to reduce strain, and ensures safety features are working correctly. Most emergency service calls we receive are from doors that haven't been maintained in years."
      }
    }
  ]
};
