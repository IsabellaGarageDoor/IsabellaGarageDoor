---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Faq from '../../components/ui/Faq.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Icon from '../../components/ui/Icon.astro';
import { site } from '../../config/site';
import type { FaqItem } from '../../lib/schema';

const title = 'AskAbel™ Assistant | Isabella Garage Door';
const description = 'Use our interactive Garage Door Assistant to quickly diagnose common garage door problems and get trusted repair advice.';

const askAbelSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "AskAbel™ Assistant",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "description": "An AI-powered virtual assistant providing 24/7 troubleshooting, repair advice, and support for residential garage door systems.",
      "author": {
        "@id": "https://isabellagaragedoor.com/#business"
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "description": "Free 24/7 virtual troubleshooting support"
      }
    },
    {
      "@type": "Service",
      "name": "24/7 Virtual Garage Door Support",
      "serviceType": "Customer Support & Diagnostics",
      "provider": {
        "@id": "https://isabellagaragedoor.com/#business"
      },
      "description": "On-demand, interactive troubleshooting and diagnostic support for common garage door and opener problems."
    }
  ]
};

const faqs: FaqItem[] = [
  { question: 'Can Abel schedule a service for me?', answer: '<p>Not directly — but he can guide you on when to book and link you to the right form.</p>' },
  { question: 'Is Abel a real person?', answer: "<p>Nope! He's powered by AI — but trained with our expertise and policies to give helpful, honest answers.</p>" },
  { question: 'What if Abel gives me the wrong info?', answer: "<p>We do our best to keep him accurate, but if something feels off, please text or call us. We're happy to confirm!</p>" },
  { question: 'What kind of questions can I ask Abel?', answer: '<p>Anything garage door related — weird noises, opener issues, spring questions, safety concerns, and more.</p>' },
];

/* Previous "Coming Soon" notice for this page (kept for later):
   This premium service is currently in development and will be available once our systems are fully in place
   to deliver the level of service our customers expect. */
---

<BaseLayout {title} {description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(askAbelSchema)} />
  </Fragment>

  <PageHero
    title="AskAbel™ Garage Door Assistant"
    eyebrow="Free · AI-powered · 24/7"
    intro="Our Garage Door Assistant, Abel, uses AI to help diagnose common issues, answer frequently asked questions, and guide you toward the right solution — all without pressure or upsells. It’s a fast, friendly way to get the help you need before booking a service.<br /><br />As part of our commitment to <em>Raising Performance. Elevating Standards.</em>, AskAbel™ helps us deliver clarity, convenience, and confidence — even before we inspect a hinge or adjust a spring."
    image="/photos/garage-door-ai-assistant.avif"
    imageAlt="AI garage door assistant"
    crumbs={[{ name: 'Homeowner Tools', href: '/homeowner-tools/easy-estimate' }, { name: 'AskAbel™', href: '#' }]}
  />

  <section class="section">
    <div class="container split">
      <div class="stack-lg stack">
        <span class="eyebrow">Simple &amp; Friendly</span>
        <h2>How It Works</h2>
        <p class="lead">
          Just type a question or describe what's going on with your garage door. Abel will respond with helpful suggestions based on garage door best practices, your issue, and our service expertise.
        </p>
        <p>
          If you're not sure whether you need a repair or a full replacement — or you're just curious about that strange noise the door started making — Abel can help you make sense of it.
        </p>
      </div>
      <figure class="abel-photo reveal">
        <img src="/photos/ask-abel-garage-door-ai-assistant.webp" alt="AI garage door assistant" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <div id="askabel" class="chat-anchor"></div>

  <section class="section section--sand">
    <div class="container container--narrow">
      <div class="section-head">
        <span class="eyebrow">Chat</span>
        <h2>Try It Now</h2>
      </div>
      <div class="chat-frame embed-placeholder">
        <iframe
          src={`https://www.chatbase.co/chatbot-iframe/${site.chatbaseId}`}
          title="AskAbel™ — Isabella Garage Door AI Assistant"
          width="100%"
          style="height: 100%; min-height: 500px"
          frameborder="0"
        ></iframe>
      </div>
      <p class="assistant-disclaimer">
        This assistant is powered by AI and is designed to provide helpful suggestions based on your input. It may occasionally make mistakes or give incorrect information — always double-check or reach out directly if you're unsure.
      </p>
    </div>
  </section>

  <Faq heading="Frequently Asked Questions" items={faqs} />

  <section class="section section--sand">
    <div class="container container--narrow text-center stack">
      <h2>Need Hands-On Help?</h2>
      <p class="lead">
        Abel is a great starting point — but if you'd rather talk to a real technician, we're just a message away.
      </p>
      <div>
        <a href="/contact" class="btn btn--navy"><Icon name="info" /> Didn’t Solve It? Request Help</a>
      </div>
    </div>
  </section>

  <ContactBlock text="Smart help. Local expertise. AskAbel™ is here 24/7." />
</BaseLayout>

<style>
  .abel-photo img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .chat-anchor {
    position: relative;
    top: calc(-1 * var(--header-h) - 1rem);
    height: 0;
  }

  .chat-frame {
    overflow: hidden;
    padding: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-lg);
  }

  .chat-frame iframe {
    border: 0;
    border-radius: var(--radius);
  }

  .assistant-disclaimer {
    margin-top: var(--space-6);
    color: var(--muted);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
