---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import SeasonalHeroImage from '../components/SeasonalHeroImage.astro';
import AvailabilityBanner from '../components/AvailabilityBanner.astro';
import AnnouncementBanner from '../components/editable-sections/AnnouncementBanner.astro';
import HolidaysBirthdaysBanner from '../components/HolidaysBirthdaysBanner.astro';
import TrustBadges from '../components/TrustBadges.astro';
import ServiceCards, { type ServiceCard } from '../components/ServiceCards.astro';
import Accordion from '../components/ui/Accordion.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import BookingCta from '../components/BookingCta.astro';
import HomeownerToolbox from '../components/HomeownerToolbox.astro';
import Faq from '../components/ui/Faq.astro';
import AskAbelCard from '../components/AskAbelCard.astro';
import BlogCards from '../components/BlogCards.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import CouponsSection from '../components/editable-sections/CouponsSection.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Icon from '../components/ui/Icon.astro';
import { serviceCardImages } from '../data/services';
import { reviews, reviewsSchema } from '../data/reviews';
import type { FaqItem } from '../lib/schema';

const title = 'Isabella Garage Door | Garage Door Service in Central Michigan';
const description = 'Professional garage door repair and replacement in Central Michigan. Honest service, fast response, and quality you can trust.';

const services: (ServiceCard & { hidden?: boolean })[] = [
  {
    title: 'Broken Spring Replacement',
    text: 'The most common garage door failure. Springs snap with a loud bang and leave your door stuck.',
    href: '/services/broken-springs',
    image: serviceCardImages.spring,
  },
  {
    title: 'General Door Repair',
    text: 'Fixing broken cables, misaligned tracks, worn-out rollers, and more — fast, clean, and dependable.',
    href: '/services/door-repair',
    image: serviceCardImages.wrench,
  },
  {
    title: 'Opener Repair &amp; Installation',
    text: 'Need a new opener? Troubleshooting a glitchy remote? We work with all major brands and smart systems.',
    href: '/services/opener-repair',
    image: serviceCardImages.opener,
  },
  // Un-hide these when licensed
  {
    title: 'New Door Installation',
    text: 'We help you choose the right door and install it with craftsmanship and care — no mess left behind.',
    href: '/services/new-door-installation',
    image: serviceCardImages.door,
    hidden: true,
  },
  {
    title: 'Agricultural &amp; Pole Barn Doors',
    text: 'We work on more than just residential garages. Pole barns, shop doors, agricultural buildings too.',
    href: '/services/door-repair',
    image: serviceCardImages.tractor,
    hidden: true,
  },
  {
    title: 'Preventive Maintenance',
    text: 'Routine maintenance helps identify small issues before they become major repairs while extending the life of your garage door and opener.',
    href: '/services/maintenance',
    image: serviceCardImages.shield,
  },
];

const why = [
  {
    title: 'Upfront Pricing — No Surprises, No Pressure',
    body: "You'll know exactly what something costs before we touch a thing. We give you a clear quote on the spot, explain your options, and never push you toward something you don't need. If it's a simple fix, we'll tell you that too.",
  },
  {
    title: 'Personal Service from a Local Family Business',
    body: 'We’re a family-run company that lives and works right here in Central Michigan. No call centers. No subcontractors. Just real people who care about doing the job right and treating you with respect.',
  },
  {
    title: 'Workmanship That Lasts',
    body: 'Our repairs <!-- and installations --> are built to stand the test of time. With premium parts and attention to detail, we don’t just get it done — we get it done right the first time.',
  },
  {
    title: 'Trusted by Homeowners Across Central Michigan',
    body: 'We’ve earned the trust of your neighbors by showing up on time, communicating clearly, and standing behind our work. You can count on us to be honest, respectful, and reliable.',
  },
  {
    title: 'Lasting Peace of Mind',
    body: 'We focus on providing lasting solutions <!-- and expert installations --> that save you time, money, and headaches down the road. Our commitment to quality materials and meticulous workmanship ensures your garage door operates reliably for years to come, giving you genuine peace of mind.',
  },
];

const promises = [
  { title: 'Rooted in the Community We Serve', text: 'Personal service from people who live and work in your community.' },
  { title: 'Satisfaction Backed by Craftsmanship', text: 'We do it right — or we make it right. Every time.' },
  { title: 'Trusted by Michigan Homeowners', text: 'Known for honest recommendations and dependable work throughout Central Michigan.' },
];

const faqs: FaqItem[] = [
  {
    question: 'Can you work on older garage doors?',
    answer: '<p>Definitely. We repair and maintain a wide range of door types—even older models. If something isn’t available, we’ll help find a good solution.</p>',
  },
  {
    question: "Will you explain what's wrong before starting work?",
    answer: '<p>Yes. Every visit starts with a thorough inspection and diagnostic test. We’ll explain the issue, go over your options, and get your approval before any repairs begin.</p>',
  },
  {
    question: 'Are your repairs guaranteed?',
    answer: '<p>Absolutely. We stand behind our work with an outstanding <a href="/resources/warranty">1 year warranty</a> and a commitment to getting it done right the first time.</p>',
  },
  {
    question: 'Can I book online?',
    answer: '<p>Yes. You can book your appointment online using our <a href="/booking">booking page</a>. Just choose a time that works for you. Prefer to reach out first? You can still <a href="/contact">contact us</a> anytime.</p><p><a href="/booking" class="btn btn--primary btn--sm">Book Online</a></p>',
  },
  {
    question: 'Still have questions?',
    answer: '<p>We’ve got a full <a href="/resources/faq">FAQ</a> page covering everything from opener issues to smart garage setups.</p><p><a href="/resources/faq" class="btn btn--outline btn--sm">Browse All FAQs</a></p>',
    inSchema: false,
  },
];
---

<BaseLayout {title} {description} legacy={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(reviewsSchema(reviews))} />
  </Fragment>

  <HomeHero
    title="Central Michigan's Trusted Garage Door Repair"
    description="Fast, reliable service to get your day back on track."
    bullets={['Locally Owned &amp; Family Operated', 'Upfront Pricing — No Surprises', 'Work Backed by a 1-Year Warranty']}
  >
    <SeasonalHeroImage slot="image" />
  </HomeHero>

  <AvailabilityBanner />

  <section class="section section--tight section--white trust-band">
    <div class="container">
      <TrustBadges />
    </div>
  </section>

  <AnnouncementBanner />
  <HolidaysBirthdaysBanner />

  <!-- Intro -->
  <section class="section">
    <div class="container container--narrow text-center stack-lg stack">
      <span class="eyebrow">Our Promise</span>
      <h2>Elevating the Standard</h2>
      <p class="lead">
        At Isabella Garage Door, we know your time, your home, and your peace of mind matter. When something breaks,
        you shouldn’t have to deal with delays, confusion, or half-done repairs. That’s why we focus on doing things the
        right way — with clear communication, quality craftsmanship, and a personal touch you can count on. We take pride
        in showing up when we say we will, respecting your space, and making sure every job is done right. It’s not just
        about fixing the door — it’s about making your day a little easier and your home feel taken care of.
      </p>
    </div>
  </section>

  <!-- Services -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Services</span>
        <h2>How We Can Help</h2>
      </div>
      <ServiceCards cards={services.filter((s) => !s.hidden)} variant="photo" />
      <div class="cluster cluster--center mt-10">
        <a href="/services/services" class="btn btn--navy"><Icon name="compass" /> Explore Our Services</a>
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="section">
    <div class="container why-grid">
      <div class="why-grid__head">
        <span class="eyebrow">Why Choose Us</span>
        <h2>Why Choose Isabella Garage Door?</h2>
        <ul class="promises">
          {promises.map((p) => (
            <li>
              <Icon name="check-circle" />
              <div>
                <strong>{p.title}</strong>
                <p>{p.text}</p>
              </div>
            </li>
          ))}
        </ul>
        <a href="/about/why-choose-isabella-garage-door" class="btn btn--outline">
          <Icon name="search" /> Learn More About Us
        </a>
      </div>
      <Accordion items={why} name="why" />
    </div>
  </section>

  <ReviewsSection intro="Here’s what Michigan homeowners are saying about Isabella Garage Door:" />
  <BookingCta />

  <!-- About -->
  <section class="section">
    <div class="container split">
      <figure class="about-photo reveal">
        <img
          src="/photos/isabella-garage-door-about-us-img.webp"
          alt="New garage door installed in Mt. Pleasant Michigan by Isabella Garage Door"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="stack-lg stack">
        <span class="eyebrow">About Us</span>
        <h2>About Isabella Garage Door</h2>
        <p class="lead">
          <strong>At Isabella Garage Door</strong>, we bring premium craftsmanship, honest service, and personal attention
          to every project. We proudly serve Central Michigan communities with expert garage door repair <!--, installation, --> and maintenance.
        </p>
        <p>
          <strong>Our commitment is simple:</strong> <em>Raising Performance. Elevating Standards.</em> From the first
          phone call to the final inspection, we prioritize clear communication, dependable workmanship, and a respectful
          experience. We don't just work in the community - we're proud to serve our neighbors with integrity and care.
        </p>
        <p><strong>Thank You!</strong> for considering Isabella Garage Door. We look forward to serving you.</p>
        <div>
          <a href="/about/our-story" class="btn btn--navy"><Icon name="users" /> Learn More About Us</a>
        </div>
      </div>
    </div>
  </section>

  <HomeownerToolbox />

  <Faq heading="Frequently Asked Questions" items={faqs} intro='Quick answers to common questions — or <a href="/resources/faq">browse all FAQs</a>.' />

  <AskAbelCard />
  <BlogCards />

  <ServiceAreaMap />
  <div class="map-cta">
    <a href="/contact" class="btn btn--navy"><Icon name="pin" /> Need Local Help?</a>
  </div>

  <CouponsSection />
  <ContactBlock text="Serving Central Michigan with honest, high-quality garage door service." />
</BaseLayout>

<style>
  .trust-band {
    border-bottom: 1px solid var(--line);
  }

  .why-grid {
    display: grid;
    gap: var(--space-10);
  }

  .why-grid__head > * + * {
    margin-top: var(--space-5);
  }

  .promises {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-2) 0;
    list-style: none;
  }

  .promises li {
    display: flex;
    gap: var(--space-3);
  }

  .promises li > :global(.icon) {
    flex-shrink: 0;
    margin-top: 0.15em;
    color: var(--bronze-600);
  }

  .promises p {
    color: var(--muted);
  }

  @media (min-width: 960px) {
    .why-grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-16);
    }
  }

  .about-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .map-cta {
    display: flex;
    justify-content: center;
    padding-bottom: var(--section-y);
    background: var(--white);
  }
</style>
