<script>
  document.addEventListener("DOMContentLoaded", function () {
    const cards = document.querySelectorAll(".homeowner-toolbox-card, .core-services-card, .reveal-on-scroll");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target); // reveal once
          }
        });
      },
      {
        threshold: 0.2, // trigger when 20% of card is visible
      }
    );

    cards.forEach((card) => {
      observer.observe(card);
    });
  });
</script>

<script is:inline>
document.querySelectorAll('.faq-item').forEach(item => {
  const question = item.querySelector('.faq-question');
  const answer = item.querySelector('.faq-answer');

  question.addEventListener('click', () => {
    const isOpen = item.classList.contains('open');

    document.querySelectorAll('.faq-item').forEach(i => {
      i.classList.remove('open');
      i.querySelector('.faq-answer').style.maxHeight = null;
    });

    if (!isOpen) {
      item.classList.add('open');
       answer.style.maxHeight = answer.scrollHeight + 'px';
    }
  });
});
</script>

<script is:inline>
  const icons = document.querySelectorAll('.core-services-icon-circle');

  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.5 }
  );
icons.forEach(icon => observer.observe(icon));
</script>

<script>
// Function to toggle accordion visibility and arrow rotation
function toggleAccordion(button) {
    const item = button.parentElement;
    const clickedContent = button.nextElementSibling;
    const clickedArrow = button.querySelector('.accordion-arrow');

    // Close all other open accordions
    document.querySelectorAll('.accordion-content').forEach(content => {
        const parentItem = content.parentElement;
        const arrow = parentItem.querySelector('.accordion-arrow');

        if (content !== clickedContent && content.style.maxHeight !== '0px' && content.style.maxHeight !== '') {
            content.style.maxHeight = '0px';
            if (arrow) arrow.style.transform = 'rotate(0deg)';
            parentItem.classList.remove('active');
        }
    });

    // Toggle the clicked accordion
    if (clickedContent.style.maxHeight === '0px' || clickedContent.style.maxHeight === '') {
        clickedContent.style.maxHeight = clickedContent.scrollHeight + 'px';
        clickedArrow.style.transform = 'rotate(180deg)';
        item.classList.add('active');
    } else {
        clickedContent.style.maxHeight = '0px';
        clickedArrow.style.transform = 'rotate(0deg)';
        item.classList.remove('active');
    }
}

// Function to initialize accordions (set them to closed on load)
function initializeAccordions() {
    document.querySelectorAll('.accordion-content').forEach(content => {
        content.style.maxHeight = '0px';
        content.parentElement.classList.remove('active');
        const arrow = content.previousElementSibling.querySelector('.accordion-arrow');
        if (arrow) arrow.style.transform = 'rotate(0deg)';
    });
}

// Make toggleAccordion available globally (used by HTML onclick)
window.toggleAccordion = toggleAccordion;

// Run initialization on first page load
document.addEventListener('DOMContentLoaded', initializeAccordions);

// Reinitialize after soft navigation (Astro)
document.addEventListener('astro:after-swap', initializeAccordions);
</script>

  <script>
    if (typeof window !== 'undefined') {
      // Animate highlight section (existing)
      const highlightObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('slide-up-in');
            observer.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.5,
        rootMargin: '0px 0px -50px 0px'
      });

      window.addEventListener('DOMContentLoaded', () => {
        const highlightSection = document.querySelector('.highlight-section');
        if (highlightSection) {
          highlightObserver.observe(highlightSection);
        }

        // Animate value icon cards with staggered delay
        const iconCards = document.querySelectorAll('.value-icon-card');
        const iconObserver = new IntersectionObserver((entries, iconObs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              // Add animation with stagger delay based on index
              const index = Array.from(iconCards).indexOf(entry.target);
              entry.target.style.animation = `fadeSlideUp 0.6s ease forwards`;
              entry.target.style.animationDelay = `${index * 150}ms`;
              iconObs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.3 });

        iconCards.forEach(card => iconObserver.observe(card));
      });
    }
  </script>

