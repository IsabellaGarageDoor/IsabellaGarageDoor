---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Icon from '../components/ui/Icon.astro';

const title = 'Page Not Found | Isabella Garage Door';
const description = 'Oops! The page you’re looking for doesn’t exist. Play a quick garage game or head back home.';

const errorSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "404 - Page Not Found",
  "description": "The page you requested could not be found.",
  "publisher": { "@id": "https://isabellagaragedoor.com/#business" },
  "mainEntity": {
    "@type": "Message",
    "text": "We couldn't find the page you were looking for. Please return to our homepage or use our diagnostic tools."
  }
};
---

<BaseLayout {title} {description}>

  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(errorSchema)} />
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  <section class="nf-hero">
    <div class="container container--narrow text-center">
      <h1>404 - Page Not Found</h1>
      <p class="nf-hero__text">
        We couldn’t find the page you were looking for.<br />
        But hey, while you're here… want to fix some virtual garage doors?
      </p>
      <div class="cluster cluster--center nf-hero__actions">
        <a href="/" class="btn btn--light">
          <Icon name="home" />
          Back to Homepage
        </a>
      </div>
    </div>
  </section>

  <section class="section section--tight nf-game">
    <div class="container">
      <!-- Game Embed -->
      <iframe
        src="/404-game.html"
        title="Garage Door Fix Game"
        loading="lazy"
        class="nf-game__frame"
      ></iframe>
    </div>
  </section>

  <script>
    window.addEventListener('message', (event) => {
      if (event.data && event.data.iframeHeight) {
        const iframe = document.querySelector<HTMLIFrameElement>("iframe[title='Garage Door Fix Game']");
        if (iframe) {
          iframe.style.height = `${event.data.iframeHeight}px`;
        }
      }
    });
  </script>

  <ContactBlock text="Oops! We couldn’t find that page — but we’re here to help with all your garage door needs across Central Michigan." />

</BaseLayout>

<style>
  .nf-hero {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    background:
      radial-gradient(circle at 100% 0%, rgb(178 125 87 / 0.2), transparent 40%),
      linear-gradient(160deg, var(--navy) 0%, var(--navy-800) 100%);
    color: rgb(255 255 255 / 0.86);
  }

  .nf-hero h1 {
    color: var(--white);
  }

  .nf-hero__text {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
  }

  .nf-hero__actions {
    margin-top: var(--space-8);
  }

  .nf-game__frame {
    display: block;
    width: 100%;
    max-width: 800px;
    height: 1000px;
    margin: 0 auto;
    border: none;
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-lg);
  }
</style>
