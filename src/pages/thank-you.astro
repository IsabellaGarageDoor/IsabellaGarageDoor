---
// Redirect target for the free-tips ebook sign-up (set in the email service, not in this repo). URL and wording must not change.
// Page <title> intentionally falls back to the site default (as before).
import BaseLayout from '../layouts/BaseLayout.astro';
import ThankYouCard from '../components/contact/ThankYouCard.astro';
import Icon from '../components/ui/Icon.astro';
---

<BaseLayout>
  <ThankYouCard title="Thank You!">
    <p class="message">Your free copy of <strong>“7 Expert Garage Door Tips Every Michigan Homeowner Should Know”</strong> is on its way to your inbox.</p>
    <p class="subtext">Be sure to check your spam or promotions folder just in case. If you have any questions, don’t hesitate to <a href="/contact">reach out</a>.</p>
    <Fragment slot="actions">
      <a href="/" class="btn btn--navy btn--lg"><Icon name="home" /> Back to Homepage</a>
    </Fragment>
  </ThankYouCard>
</BaseLayout>
