---
import BaseLayout from '../layouts/BaseLayout.astro';
import SaveContactBanner from '../components/SaveContactBanner.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import PageHero from '../components/ui/PageHero.astro';
import Price from '../components/ui/Price.astro';
import ContactBlock from '../components/ContactBlock.astro';
import ContactMethods from '../components/contact/ContactMethods.astro';
import Icon from '../components/ui/Icon.astro';

const title = 'Schedule Garage Door Service | Isabella Garage Door';
const description = 'Book a garage door service call online with Isabella Garage Door. Serving Mt. Pleasant, Clare, Alma, Shepherd, and all of Central Michigan.';

const bookingSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://isabellagaragedoor.com/booking",
      "url": "https://isabellagaragedoor.com/booking",
      "name": "Schedule Garage Door Service | Isabella Garage Door",
      "description": "Book a garage door service call online. Isabella Garage Door serves Mt. Pleasant, Clare, Alma, Shepherd, and all of Central Michigan.",
      "mainEntity": {
        "@id": "https://isabellagaragedoor.com/#business"
      }
    },
    {
      "@type": "Service",
      "name": "Garage Door Service Call",
      "provider": {
        "@id": "https://isabellagaragedoor.com/#business"
      },
      "areaServed": [
        "Mount Pleasant", "Alma", "Clare", "Rosebush", "Shepherd",
        "Weidman", "Coleman", "Farwell", "Lake Isabella", "Remus",
        "Edmore", "St. Louis", "Winn", "Beal City"
      ],
      "description": "A technician visits your home to diagnose and repair your garage door issue. Common repairs include spring replacement, cable repair, roller replacement, opener troubleshooting, and track adjustment.",
      "availableChannel": {
        "@type": "ServiceChannel",
        "serviceUrl": "https://isabellagaragedoor.com/booking"
      }
    },
    {
      "@type": "ContactPoint",
      "telephone": "+1-989-572-0303",
      "contactType": "customer service",
      "email": "isabellagaragedoor@gmail.com",
      "areaServed": [
        "Mount Pleasant", "Alma", "Clare", "Rosebush", "Shepherd",
        "Weidman", "Coleman", "Farwell", "Lake Isabella", "Remus",
        "Edmore", "St. Louis", "Winn", "Beal City"
      ],
      "availableLanguage": "en"
    }
  ]
};
---

<BaseLayout {title} {description}>

  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(bookingSchema)} />
  </Fragment>

  <PageHero
    title="Schedule a Service Call Online"
    intro="Not sure what's wrong with your garage door? That's exactly what a service call is for. Book an appointment below and we'll come out, inspect the full system, and give you a straight answer on what's going on and what it will take to fix it — no guesswork, no pressure. Most issues are resolved the same visit."
    image="/photos/book-garage-door-service-online.avif"
    imageAlt="Schedule a garage door service call online in Central Michigan with Isabella Garage Door"
    crumbs={[{ name: 'Book Online', href: '/booking' }]}
  >
    <p class="booking-hero__note">
      Don't see a time that works for you? We have additional slot times available and can usually work you into our schedule. Just give us a call or text
      to find out more.
    </p>
  </PageHero>

  <!-- ================================================
       SQUARE BOOKING WIDGET
       ================================================ -->
  <section class="section booking-widget-section">
    <div class="container booking-widget-wrap">
      <div id="book-online" class="booking-widget">
        <!-- Start Square Appointments Embed Code -->
        <div class="embed-placeholder">
          <script is:inline src='https://square.site/appointments/buyer/widget/bs4l0fegqblc5h/LMJS6ZXSNBX8B.js'>
          </script>
        </div>
        <!-- End Square Appointments Embed Code -->
      </div>

      <p class="booking-help">
        <Icon name="phone" class="booking-help__icon" />
        <span><strong>Need help now? </strong><a href="tel:+19895720303">Call or text 989-572-0303</a> for an immediate response.</span>
      </p>
    </div>
  </section>
  <!-- ================================================ -->

  <section class="section section--sand">
    <div class="container booking-info">
      <div class="booking-info__main">
        <span class="eyebrow">Before Your Visit</span>
        <h2>How it works</h2>
        <div class="prose">
          <p>
            When we arrive, we go through the whole system — springs, cables, rollers, tracks,
            opener — and tell you exactly what we find. The <strong>service call fee is <Price name="serviceCallFee" /></strong>,
            which covers the visit and the diagnosis. If your door just needs a quick adjustment
            or something minor like realigning the photo sensors, that's handled as part of the
            service call and you're all set.
          </p>
          <p>
            If new parts are going in — a spring replacement, new cables, rollers, or anything
            beyond adjustments — the <Price name="serviceCallFee" /> fee is waived and you only pay for the repair. You can
            get a head start on what things typically cost by checking out our
            <a href="/homeowner-tools/easy-estimate#estimate-form">EasyEstimate&trade;</a> tool before
            your appointment. Either way, you'll have the full price in front of you before
            anything is touched, and nothing gets done without your go-ahead.
          </p>
          <p>
            Payment is collected on-site when the work is done — cash, check, or card all work.
            When you book online you'll be asked to put a card on file through Square's secure
            system, but it isn't charged until the job is finished and you've signed off. We just
            ask that you're home for the appointment, or that you've made arrangements with us
            ahead of time. If we show up and can't reach you, the service call fee may be applied
            to the card on file.
          </p>
          <p>
            If something comes up, no problem — just cancel or reschedule at least an hour before
            your appointment and there's no charge.
          </p>
        </div>
      </div>

      <aside class="booking-info__aside">
        <div class="card booking-info__card">
          <ContactMethods
            heading="Prefer to call or text?"
            sms="sms:+19895720303?&body=Hi%2C%20I%27d%20like%20to%20schedule%20a%20garage%20door%20service."
          />
          <SaveContactBanner />
        </div>
      </aside>
    </div>
  </section>

  <ServiceAreaMap />

  <ContactBlock text="Serving Central Michigan with honest, high-quality garage door service." />

</BaseLayout>

<style>
  .booking-hero__note {
    margin-top: var(--space-5);
    max-width: 40rem;
    color: rgb(255 255 255 / 0.78);
  }

  .booking-widget-wrap {
    max-width: calc(860px + 2 * var(--gutter));
  }

  .embed-placeholder {
    min-height: 12rem;
    padding: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
    border: 1px solid var(--line);
    border-top: 4px solid var(--bronze);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-lg);
    color: var(--muted);
    font-size: 1.1rem;
    text-align: center;
  }

  .booking-help {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
    color: var(--text);
    text-align: center;
  }

  .booking-help a {
    white-space: nowrap;
    font-weight: 600;
  }

  .booking-help :global(.booking-help__icon) {
    flex-shrink: 0;
    color: var(--bronze-600);
  }

  .booking-info {
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }

  .booking-info__main > * + * {
    margin-top: var(--space-4);
  }

  .booking-info__main .prose {
    margin-top: var(--space-6);
  }

  .booking-info__card {
    padding: var(--space-6);
  }

  @media (min-width: 960px) {
    .booking-info {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-16);
    }

    .booking-info__aside {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>
