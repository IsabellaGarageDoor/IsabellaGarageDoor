---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Paginate from '../../components/Paginate.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Icon from '../../components/ui/Icon.astro';

const title = 'Learning Center | Isabella Garage Door';
const description = 'Explore expert tips, how-tos, and helpful guides to keep your garage door running smoothly and safely.';

// Get all blog posts
const allPosts = await getCollection('blog');

// Sort posts by date (newest first)
const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});

// Pagination happens in the browser (?page=N) — see components/Paginate.astro
const postsPerPage = 8;
// Structured data lists the first page of articles
const paginatedPosts = sortedPosts.slice(0, postsPerPage);

const learningCenterSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://isabellagaragedoor.com/resources/learning-center",
      "url": "https://isabellagaragedoor.com/resources/learning-center",
      "name": "Isabella Garage Door Learning Center",
      "description": "Expert tips, maintenance guides, and troubleshooting advice for Central Michigan homeowners.",
      "publisher": { "@id": "https://isabellagaragedoor.com/#business" },
      "mainEntity": {
        "@type": "ItemList",
        "name": "Latest Garage Door Resources",
        "numberOfItems": paginatedPosts.length,
        "itemListElement": paginatedPosts.map((post, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "url": `https://isabellagaragedoor.com/blog/${post.id}`,
          "name": post.data.title,
          "description": post.data.description
        }))
      }
    }
  ]
};
---

<BaseLayout {title} {description} legacy={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(learningCenterSchema)} />
  </Fragment>

  <PageHero
    title="Learning Center"
    eyebrow="Garage Door Tips &amp; Guides"
    intro="Welcome to the Learning Center — your go-to garage door resource for expert tips, how-to guides, and helpful insights in Central Michigan. Whether you're troubleshooting a strange noise, planning a replacement, or just staying ahead on maintenance, you're in the right place."
    image="/photos/learning-center-garage-door.avif"
    imageAlt="Beautiful garage door fixed and working again"
    crumbs={[{ name: 'Learning Center', href: '/resources/learning-center' }]}
  >
    <Fragment slot="actions">
      <a href="/search" class="btn btn--light"><Icon name="search" /> Search Articles</a>
      <span class="search-hint">Find answers about springs, rollers, openers, and more</span>
    </Fragment>
  </PageHero>

  <section class="section" id="articles">
    <div class="container">
      <Paginate perPage={postsPerPage} anchor="articles" class="grid grid--4 article-grid">
        {sortedPosts.map((post) => (
          <ArticleCard post={post} showDate headingLevel="h2" />
        ))}
      </Paginate>
    </div>
  </section>

  <ContactBlock text="Helpful tips, honest answers, and smart guidance — all from your local garage door experts." />
</BaseLayout>

<style>
  .search-hint {
    color: rgb(255 255 255 / 0.75);
    font-size: var(--text-sm);
  }
</style>
