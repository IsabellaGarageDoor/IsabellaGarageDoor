---
title: "Pricing - Isabella Garage Door"
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Faq from '../../components/ui/Faq.astro';
import BookingCta from '../../components/BookingCta.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Icon from '../../components/ui/Icon.astro';
import type { FaqItem } from '../../lib/schema';
import { serviceCallFee, repairPriceGroups, performanceMembership } from '../../data/pricing';

const title = 'Pricing | Isabella Garage Door';
const description = 'Honest, local garage door repair in Central Michigan. Flat service call, clear pricing, and trusted professional service.';

const pricingSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://isabellagaragedoor.com/resources/pricing",
      "url": "https://isabellagaragedoor.com/resources/pricing",
      "name": "Garage Door Service Pricing",
      "description": "Transparent pricing for garage door repairs and maintenance in Mid-Michigan."
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Garage Door Diagnostic & Service Visit",
        "description": "A full safety inspection and professional diagnosis."
      },
      "price": serviceCallFee.schemaPrice,
      "priceCurrency": serviceCallFee.currency,
      "description": "Flat rate service visit applied toward the cost of your repair.",
      "areaServed": {
        "@type": "State",
        "name": "Michigan"
      },
      "seller": {
        "@id": "https://isabellagaragedoor.com/#business"
      }
    }
  ]
};

const warrantyItems = [
  { icon: 'shield', title: 'Full Coverage Protection', text: '1 year warranty on all parts we supply and install, including labor.' },
  { icon: 'wrench', title: 'Installation Assurance', text: '1 year warranty on the installation of customer-supplied parts.' },
  { icon: 'award', title: 'Extended Manufacturer Advantage', text: 'If a manufacturer’s warranty exceeds ours, you receive the longer coverage automatically.' },
  { icon: 'handshake', title: 'No-Hassle Promise', text: 'If something fails during the warranty period, we return and fix it at no cost to you.' },
];

const membershipPerks = [
  'Biannual performance tuning with full inspection and documentation',
  'Lifetime coverage on all wear components (parts & labor included)',
  'VIP priority scheduling—front-of-the-line service',
  'Invisible service via keypad/MyQ access—no need to be home',
  `${performanceMembership.discount} member discount on openers, electronics, and specialty parts`,
  'Batteries and bulbs replaced automatically during spring visit',
];

const faqs: FaqItem[] = [
  {
    question: 'What does your service call include?',
    answer: '<p>Our service call is a <strong>full inspection and safety check</strong>, not just a “trip to your house.” It ensures your door is safe and reliable — and the fee is waived if you approve a repair and we still perform the inspection and safety check.</p>',
  },
  {
    question: 'What if I don’t approve a repair?',
    answer: '<p>You’ll only pay the service call fee, which covers our time, travel, and the full inspection/report. You still leave with a clear understanding of your door’s condition.</p>',
  },
  {
    question: 'Can I get an exact price without a visit?',
    answer: '<p>Our EasyEstimate™ tool gives a ballpark range. For precise pricing, an on-site inspection is required because every door is unique.</p>',
  },
  {
    question: 'Do you match competitor coupons?',
    answer: '<p>Our focus is on <strong>value, quality, and reliability</strong> rather than competing on price. You get premium service, a full inspection, and a professional repair done right the first time.</p>',
  },
];
---

<BaseLayout {title} {description} legacy={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />
  </Fragment>

  <PageHero
    title="Our Pricing Structure"
    eyebrow="Pricing"
    intro="At Isabella Garage Door, we believe in <strong>straightforward, transparent pricing</strong> with no hidden fees or surprises. Our goal is to make it easy for you to understand what to expect and why — every visit, every repair, every time."
    image="/photos/estimate-image-garage-door-service.avif"
    imageAlt="Isabella Garage Door Giving Estimate for Garage Door Repair"
    crumbs={[{ name: 'Resources', href: '/resources/resources-landing-page' }, { name: 'Pricing', href: '/resources/pricing' }]}
  >
    <a href="/resources/warranty" class="warranty-badge">
      <Icon name="shield" />
      <span><strong>One Year Warranty on Parts & Labor</strong>.</span>
    </a>
  </PageHero>

  <!-- Service call fee -->
  <section class="section" id="pricing-structure">
    <div class="container split fee">
      <div class="stack">
        <span class="eyebrow">Service Call</span>
        <h2>Service Call Fee</h2>
        <p class="fee__headline"><strong>{serviceCallFee.display} Flat Rate Service Visit – Applied Toward Your Repair</strong></p>
        <p>Your service call isn’t just a “trip charge.” It’s a <strong>full, value-packed diagnostic visit</strong> that includes:</p>
        <ul class="check-list">
          <li><Icon name="check-circle" /> <span>Travel to your home anywhere in Isabella County and surrounding areas</span></li>
          <li><Icon name="check-circle" /> <span>Comprehensive inspection</span></li>
          <li><Icon name="check-circle" /> <span>Complete safety evaluation of springs, sensors, cables, rollers, and opener</span></li>
          <li><Icon name="check-circle" /> <span>Professional diagnosis and written repair estimate</span></li>
        </ul>
      </div>
      <div class="card fee__card">
        <span class="fee__price">{serviceCallFee.display}</span>
        <p><strong>Waived with Repair:</strong> If you approve repairs during our visit, the service call fee is <strong>applied toward the cost of the work</strong>, so you’re only paying for the repair itself.</p>
        <p>This approach ensures:</p>
        <ul class="check-list">
          <li><Icon name="check" /> <span>You get professional attention even if you’re unsure what’s wrong</span></li>
          <li><Icon name="check" /> <span>Full peace of mind about your door’s safety and performance</span></li>
          <li><Icon name="check" /> <span>Clear, upfront pricing before you commit</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Price ranges -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Price Ranges</span>
        <h2>Common Repairs & Price Ranges</h2>
        <p>While every garage door is unique, here are typical price ranges and what they cover:</p>
      </div>

      <div class="plans">
        {repairPriceGroups.map((group) => (
          <article class="plan reveal">
            <h3 class="plan__heading">{group.heading}</h3>
            <ul class="plan__items">
              {group.items.map((item) => (
                <li>
                  <div class="plan__row">
                    <h4>{item.name}</h4>
                    <span class="plan__range">({item.range})</span>
                  </div>
                  <p>{item.description}</p>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <p class="price-note"><em>Note: Final pricing depends on your door’s size, condition, and system complexity. Written estimates are always provided before any work begins.</em></p>
    </div>
  </section>

  <!-- Warranty -->
  <section class="section">
    <div class="container">
      <a href="/resources/warranty" class="warranty-card">
        <div class="section-head">
          <span class="eyebrow">Warranty</span>
          <h2>Our 1-Year Service Warranty</h2>
          <p>Every repair we perform is backed by a clear, written warranty designed to give you complete confidence in our work.</p>
        </div>
        <div class="grid grid--4">
          {warrantyItems.map((w) => (
            <div class="warranty-item">
              <span class="card__icon"><Icon name={w.icon} /></span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </div>
          ))}
        </div>
      </a>
    </div>
  </section>

  <!-- EasyEstimate -->
  <section class="section section--sand">
    <div class="container split">
      <figure class="estimate-logo">
        <img src="/photos/easyestimate-logo.webp" alt="Recieve a Free Estimate from Isabella Garage Door when you use our Estimate Tool" loading="lazy" decoding="async" />
      </figure>
      <div class="stack">
        <span class="eyebrow">Homeowner Tool</span>
        <h2>EasyEstimate™</h2>
        <p>Want a <strong>quick ballpark estimate</strong> without scheduling a visit? Our EasyEstimate™ tool gives approximate pricing for common issues in seconds:</p>
        <ul class="check-list">
          <li><Icon name="check-circle" /> <span>Get instant cost ranges</span></li>
          <li><Icon name="check-circle" /> <span>Plan your repair budget</span></li>
          <li><Icon name="check-circle" /> <span>Understand likely solutions before we arrive</span></li>
        </ul>
        <div><a href="/homeowner-tools/easy-estimate#estimate-form" class="btn btn--navy"><Icon name="calculator" /> EasyEstimate™</a></div>
        <p class="text-muted"><strong>Remember:</strong> This tool provides a starting point. Every door is different, and our on-site inspection ensures precise pricing and safety.</p>
      </div>
    </div>
  </section>

  <!-- Pricing promise -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our Promise</span>
        <h2>Our Pricing Promise</h2>
      </div>
      <div class="grid grid--2 promise">
        <div class="card">
          <span class="card__icon"><Icon name="search" /></span>
          <h3>Complete Transparency</h3>
          <ul class="check-list">
            <li><Icon name="check" /> <span>Written estimates before any work begins</span></li>
            <li><Icon name="check" /> <span>Clear explanations of recommended repairs</span></li>
            <li><Icon name="check" /> <span>Multiple options presented when possible</span></li>
            <li><Icon name="check" /> <span>No-pressure consultation</span></li>
          </ul>
        </div>
        <div class="card">
          <span class="card__icon"><Icon name="tag" /></span>
          <h3>Fair Market Pricing</h3>
          <ul class="check-list">
            <li><Icon name="check" /> <span>Competitive rates for professional-grade service</span></li>
            <li><Icon name="check" /> <span>Quality parts and materials included</span></li>
            <li><Icon name="check" /> <span>Expertly trained, insured technicians</span></li>
            <li><Icon name="check" /> <span>Warranty coverage on all repairs</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Performance Membership -->
  <section class="section section--navy membership">
    <div class="container split">
      <div class="stack">
        <span class="eyebrow">Membership</span>
        <h2>Performance Membership</h2>
        <p>The smarter way to own a garage door. <strong>Performance Membership</strong> means you never pay for springs, rollers, cables, hinges, or bearings again—ever.</p>
        <p class="membership__price"><strong>{performanceMembership.price}.</strong> The "Never Worry Again" plan for Central Michigan homeowners.</p>
        <div><a href="/services/performance-membership" class="btn btn--primary"><Icon name="shield" /> Join Performance Membership</a></div>
      </div>
      <ul class="check-list membership__perks">
        {membershipPerks.map((perk) => (
          <li><Icon name="check-circle" /> <span>{perk}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <Faq heading="Frequently Asked Questions" items={faqs}>
    <p class="text-center mt-8">
      <a href="/resources/faq" class="btn btn--outline btn--sm">Browse All FAQs</a>
    </p>
  </Faq>

  <!-- Schedule -->
  <section class="section section--sand">
    <div class="container container--narrow text-center stack-lg stack">
      <span class="eyebrow">Get Started</span>
      <h2>Schedule Your Service</h2>
      <p class="lead">Whether you need a repair or just want a professional inspection, we’re ready to help.</p>
      <div class="cluster cluster--center">
        <a href="/contact" class="btn btn--navy"><Icon name="calendar" /> Book Your Appointment</a>
      </div>
    </div>
  </section>

  <BookingCta />
  <ContactBlock text="Professional service. Transparent pricing. Trusted results." />
</BaseLayout>

<style>
  :global(.page-hero strong) {
    color: var(--white);
  }

  .warranty-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border: 1px solid rgb(178 125 87 / 0.6);
    border-radius: var(--radius-pill, 999px);
    background: rgb(255 255 255 / 0.06);
    color: var(--white) !important;
    text-decoration: none;
  }

  .warranty-badge:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .warranty-badge :global(.icon) {
    color: var(--bronze-300);
  }

  .fee {
    align-items: center;
  }

  .fee__headline {
    color: var(--navy);
    font-size: var(--text-lg);
  }

  .fee__card {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-top: 4px solid var(--bronze);
    box-shadow: var(--shadow);
  }

  .fee__card p {
    color: var(--text);
  }

  .fee__price {
    color: var(--navy);
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 600;
    line-height: 1;
  }

  .plans {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    align-items: start;
  }

  .plan {
    position: relative;
    overflow: hidden;
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-top: 4px solid var(--bronze);
    border-radius: var(--radius-lg);
    background: var(--white) url('/photos/white-garage-door-service-section.webp') center / cover no-repeat;
    box-shadow: var(--shadow);
  }

  .plan::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(255 255 255 / 0.88);
  }

  .plan > * {
    position: relative;
  }

  .plan__heading {
    font-size: 1.35rem;
  }

  .plan__items {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .plan__items li + li {
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .plan__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
  }

  .plan__row h4 {
    color: var(--navy);
    font-family: var(--font-heading);
    font-size: 1.05rem;
  }

  .plan__range {
    color: var(--bronze-700);
    font-weight: 600;
    white-space: nowrap;
  }

  .plan__items p {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .price-note {
    max-width: 46rem;
    margin: var(--space-10) auto 0;
    color: var(--muted);
    text-align: center;
  }

  .warranty-card {
    display: block;
    padding: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    border: 1px solid var(--bronze);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 100% 0%, rgb(178 125 87 / 0.2), transparent 45%),
      linear-gradient(160deg, var(--navy), var(--navy-800));
    box-shadow: var(--shadow-lg);
    color: rgb(255 255 255 / 0.86);
    text-decoration: none;
  }

  .warranty-card:hover {
    color: rgb(255 255 255 / 0.86);
  }

  .warranty-card h2 {
    color: var(--white);
  }

  .warranty-card .eyebrow {
    color: var(--bronze-300);
  }

  .warranty-card .section-head p {
    color: rgb(255 255 255 / 0.8);
  }

  .warranty-item {
    padding: var(--space-6);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--text);
    transition: transform var(--duration) var(--ease);
  }

  .warranty-card:hover .warranty-item {
    transform: translateY(-2px);
  }

  .warranty-item > * + * {
    margin-top: var(--space-3);
  }

  .warranty-item h3 {
    font-size: 1.1rem;
  }

  .warranty-item p {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .estimate-logo img {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    border-radius: var(--radius-lg);
  }

  .promise .card {
    padding: var(--space-8);
  }

  .membership .split {
    align-items: center;
  }

  .membership__price {
    font-size: var(--text-lg);
  }

  .membership__price strong {
    color: var(--bronze-300);
    font-family: var(--font-heading);
    font-size: 1.6rem;
  }

  .membership__perks {
    padding: var(--space-6);
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.05);
  }

  .membership__perks :global(.icon) {
    color: var(--bronze-300);
  }
</style>
