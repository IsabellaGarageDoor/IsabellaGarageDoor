---
title: "Resources - Isabella Garage Door"
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import BookingCta from '../../components/BookingCta.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Icon from '../../components/ui/Icon.astro';

const resourcesSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://isabellagaragedoor.com/resources/resources-landing-page",
      "url": "https://isabellagaragedoor.com/resources/resources-landing-page",
      "name": "Isabella Garage Door Homeowner Resources",
      "description": "A curated collection of guides, FAQs, and maintenance tips to help homeowners manage their garage door systems.",
      "publisher": { "@id": "https://isabellagaragedoor.com/#business" },
      "hasPart": [
        {
          "@type": "WebPage",
          "name": "Learning Center",
          "url": "https://isabellagaragedoor.com/resources/learning-center",
          "description": "In-depth articles and guides on garage door maintenance and upgrades."
        },
        {
          "@type": "WebPage",
          "name": "Frequently Asked Questions",
          "url": "https://isabellagaragedoor.com/resources/faq",
          "description": "Quick answers to common garage door repair and service questions."
        }
      ]
    }
  ]
};
---

<BaseLayout legacy={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(resourcesSchema)} />
  </Fragment>

  <PageHero
    title="Resources"
    eyebrow="Homeowner Resources"
    intro="Explore expert insight, seasonal advice, and practical tips from our team — plus answers to the most common questions homeowners ask us every week."
    crumbs={[{ name: 'Resources', href: '/resources/resources-landing-page' }]}
  />

  <section class="section">
    <div class="container">
      <div class="grid grid--2 resources-grid">
        <a href="/resources/learning-center" class="card card--link resource-card reveal">
          <span class="card__icon"><Icon name="clipboard" /></span>
          <h2>Learning Center</h2>
          <p>
            Articles to help you understand, maintain, and make smart decisions about your garage door system — from seasonal maintenance to long-term upgrades.
          </p>
          <span class="link-arrow card__more">Explore Articles <Icon name="arrow-right" size="1em" /></span>
        </a>

        <a href="/resources/faq" class="card card--link resource-card reveal">
          <span class="card__icon"><Icon name="info" /></span>
          <h2>Frequently Asked Questions</h2>
          <p>
            Quick, clear answers to our most asked questions — from repair expectations to safety advice and service details.
          </p>
          <span class="link-arrow card__more">View FAQs <Icon name="arrow-right" size="1em" /></span>
        </a>
      </div>
    </div>
  </section>

  <BookingCta />
  <ContactBlock />
</BaseLayout>

<style>
  .resource-card {
    padding: var(--space-8);
  }

  .resource-card h2 {
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.8rem);
  }
</style>
