---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Faq from '../../components/ui/Faq.astro';
import AskAbelCard from '../../components/AskAbelCard.astro';
import BookingCta from '../../components/BookingCta.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Icon from '../../components/ui/Icon.astro';
import { faqPageSchema, type FaqItem } from '../../lib/schema';
import { site, telHref, mailtoHref } from '../../config/site';

const title = 'FAQs | Isabella Garage Door';
const description = 'Find answers to common questions about garage door repair, installation, maintenance, and more from our experienced team.';

interface FaqGroup {
  /** Anchor id for the category section (#faq, #faq-repairs, …) */
  id: string;
  heading: string;
  /** Owner-hidden category (kept for later, not rendered) */
  hidden?: boolean;
  items: (FaqItem & { hidden?: boolean })[];
}

// Visible answers are the single source: the FAQPage structured data below is
// generated from exactly the questions shown on the page.
const groups: FaqGroup[] = [
  {
    id: 'faq',
    heading: 'General Questions',
    items: [
      {
        question: 'What areas do you service?',
        answer: '<p>We proudly serve <a href="/locations/mt-pleasant">Mount Pleasant</a>, <a href="/locations/alma">Alma</a>, <a href="/locations/clare">Clare</a>, and surrounding areas in <a href="/locations/central-michigan">Central Michigan</a>.</p>',
      },
      {
        question: 'What are your business hours?',
        answer: '<p>We typically are available most afternoons.</p>',
      },
      {
        question: 'Are you locally owned?',
        answer: '<p>Yes! Isabella Garage Door is a locally owned and family-operated business based in <a href="/locations/isabella-county">Isabella County</a>, Michigan.</p>',
      },
      {
        question: 'How do I schedule a service call?',
        answer: '<p>The fastest and easiest way to schedule is by booking directly through our <a href="/booking">online booking page</a>. You can also submit a request through our <a href="/homeowner-tools/easy-estimate">EasyEstimate tool</a>, or contact us by <a href="tel:+19895720303">call</a>, <a href="sms:+19895720303">text</a>, <a href="mailto:isabellagaragedoor@gmail.com">email</a>, or our <a href="/contact">website form</a>.</p>',
      },
      {
        question: 'Do you provide same-day service?',
        answer: '<p>In many cases, yes! However it will depend on our current availability.</p>',
      },
      {
        question: 'Are you insured?',
        answer: '<p>Yes. Isabella Garage Door is fully insured for residential garage door services. We operate with transparency and uphold all local regulations to protect your home and our work.</p>',
      },
      {
        question: 'How quickly can I expect a response?',
        answer: '<p>We typically respond the same day — often within a few hours.</p>',
      },
      {
        question: 'Do you only work on certain brands?',
        answer: '<p>No — we service all major residential garage door and opener brands regardless of who installed them originally.</p>',
      },
      {
        question: 'Do I need to be home for the service call?',
        answer: '<p>For most repairs, yes — we\'ll need access to the garage and prefer to walk you through the work when finished. If your situation is unique, reach out and we can discuss options.</p>',
      },
      {
        question: 'Will you explain what\'s wrong before doing any work?',
        answer: '<p>Always. We diagnose the problem first, explain what we found, and give you a clear price before touching anything. No surprises.</p>',
      },
      {
        question: 'Do you work on commercial garage doors?',
        answer: '<p>No — we specialize exclusively in residential garage doors and openers. If you need commercial service, we recommend contacting a commercial door specialist.</p>',
      },
      {
        question: 'Can you tell me over the phone what\'s wrong with my door?',
        answer: '<p>Sometimes. If you describe the symptoms, we can often give you a good idea of what\'s going on and whether it\'s urgent. You can also use our <a href="/homeowner-tools/door-diagnosis">DoorDiagnosis tool</a> online, But an accurate diagnosis really requires seeing the door in person — there\'s a lot we can miss without being there.</p>',
      },
    ],
  },
  {
    id: 'faq-repairs',
    heading: 'Repairs & Service',
    items: [
      {
        question: 'How much does it cost to fix a broken garage door spring?',
        answer: '<p>The cost varies depending on the size and weight of your door, but you can get a ballpark price in under 60 seconds using our <a href="/homeowner-tools/easy-estimate">EasyEstimate™ tool</a>. We focus on value by using high-cycle springs that last twice as long as standard ones.</p>',
      },
      {
        question: 'My door won\'t open. Should I try to fix it myself?',
        answer: '<p>If you hear a loud bang or see a gap in your spring, do not attempt to open the door. Garage door springs are under extreme tension and can be dangerous. It is best to keep the door closed and call a professional for a safe repair.</p>',
      },
      {
        question: 'My garage door is making a loud grinding or squeaking noise. Is that serious?',
        answer: '<p>Not always — sometimes it just needs lubrication. But grinding can also indicate worn rollers, loose hardware, or a failing opener gear. If the noise is new or getting worse, it\'s worth having it looked at before a small issue becomes a bigger repair.</p>',
      },
      {
        question: 'My door opens but won\'t close all the way. What\'s causing that?',
        answer: '<p>This is usually a safety sensor issue. The sensors at the bottom of your door tracks need to be aligned and unobstructed. It can also be a travel limit setting on the opener. Both are straightforward fixes.</p>',
      },
      {
        question: 'My garage door goes back up right after it closes. What\'s going on?',
        answer: '<p>That\'s almost always the safety sensors detecting something in the path — real or imagined. Misaligned sensors, a dirty sensor lens, or direct sunlight interference can all trigger it. It\'s a quick fix in most cases.</p>',
      },
      {
        question: 'My remote stopped working. Do I need a new opener?',
        answer: '<p>Probably not. Start with fresh batteries. If that doesn\'t fix it, the remote may need to be reprogrammed or replaced — both inexpensive fixes. A new opener is rarely the answer for a remote issue alone.</p>',
      },
      {
        question: 'How long do garage door springs last?',
        answer: '<p>Standard springs are rated for around 10,000 cycles — roughly 7 to 10 years with average use. High-cycle springs are rated for 25,000+ cycles, which significantly extends the life of your system.</p>',
      },
      {
        question: 'Can you repair broken garage door panels?',
        answer: '<p>In some cases, yes — especially if the damage is cosmetic or isolated. We\'ll let you know whether a repair or panel replacement makes more sense.</p>',
      },
      {
        question: 'My opener works but the door doesn\'t move. What\'s wrong?',
        answer: '<p>This could be a <a href="/services/broken-springs">broken spring</a> or disconnected drive mechanism. We\'ll assess and fix the issue safely — never try to force the door open yourself.</p>',
      },
      {
        question: 'Is it safe to use my garage door if a spring is broken?',
        answer: '<p>No. A <a href="/services/broken-springs">broken spring</a> puts enormous strain on your opener and cables, and the door can drop unexpectedly. Keep it closed and <a href="/contact#contact-form">contact us</a> — this is one repair you don\'t want to delay.</p>',
      },
      {
        question: 'My garage door is off its tracks. Can I fix it myself?',
        answer: '<p>We strongly advise against it. A door off its tracks is under uneven tension and can fall without warning. It\'s one of the more dangerous DIY attempts we see go wrong. <a href="tel:+19895720303">Call</a> us and keep the door where it is until we arrive.</p>',
      },
      {
        question: 'How long does a typical garage door repair take?',
        answer: '<p>Most common repairs take about an hour, sometimes two. More involved jobs may take a bit longer. We\'ll give you a time estimate before we start.</p>',
      },
      {
        question: 'One side of my garage door looks crooked or uneven. What\'s wrong?',
        answer: '<p>An uneven door usually means one spring has broken or lost tension, or a cable has come off the drum. Either way, don\'t force it — operating the door in that condition can cause further damage or injury.</p>',
      },
      {
        question: 'How do I know if I need a repair or a full replacement?',
        answer: '<p>It depends on the age of the door and opener, the extent of the damage, and what a repair would cost relative to replacement. We\'ll always give you an honest recommendation — if a repair makes more sense, we\'ll say so. If the door is at the end of its life, we\'ll tell you that too.</p>',
      },
    ],
  },
  {
    id: 'faq-safety',
    heading: 'Safety',
    items: [
      {
        question: 'How do I test if my garage door\'s auto-reverse is working?',
        answer: '<p>Place a 2x4 flat on the ground in the center of the door opening. Close the door — it should reverse automatically when it contacts the board. If it doesn\'t, your auto-reverse needs adjustment. This is a critical safety feature, especially if you have children or pets.</p>',
      },
      {
        question: 'My garage door came down on my car. What should I do?',
        answer: '<p>Don\'t try to force the door back up manually. If the door came off track or the cables came off the drum DO NOT go near it! <a href="tel:+19895720303">Call</a> us — we\'ll get there quickly and handle it without causing additional damage to your car or the door system.</p>',
      },
      {
        question: 'Is my old garage door opener safe?',
        answer: '<p>Openers made before 1993 don\'t have the auto-reverse feature required by law today, which means they can close on people, pets, or objects without stopping. If your opener is more than 20–25 years old, replacement is worth serious consideration for safety alone.</p>',
      },
      {
        question: 'Can a garage door opener be hacked?',
        answer: '<p>Older openers using fixed-code remotes can be vulnerable to signal capture. Modern openers use rolling code technology that changes with every use, making them significantly more secure. If your opener is old, this is one more reason to consider an upgrade.</p>',
      },
    ],
  },
  {
    id: 'faq-weather',
    heading: 'Weather & Michigan winters',
    items: [
      {
        question: 'Why does my garage door struggle to open in cold weather?',
        answer: '<p>Cold temperatures cause metal components to contract and lubricants to thicken, which increases resistance throughout the system. Springs especially lose efficiency in the cold. A pre-winter tune-up with the right lubricant can make a noticeable difference.</p>',
      },
      {
        question: 'My garage door froze to the ground overnight. What do I do?',
        answer: '<p>Don\'t force it with the opener — you can burn out the motor. Use a hair dryer along the bottom seal to melt the ice. Once it\'s free, apply a silicone-based lubricant to the bottom seal to help prevent it from happening again.</p>',
      },
      {
        question: 'Should I insulate my garage door for Michigan winters?',
        answer: '<p>If you use your garage for anything beyond parking — a workshop, storage, laundry — insulation is worth it. It keeps temps more stable, reduces strain on the opener in cold weather, and cuts down on noise. Michigan winters are hard on uninsulated doors.</p>',
      },
      {
        question: 'How does humidity affect my garage door?',
        answer: '<p>High humidity can cause wooden doors to swell and warp, and accelerate rust on springs, cables, and hardware. It can also affect sensor performance. Keeping your door lubricated and ensuring good weatherstripping goes a long way in Michigan\'s humid summers.</p>',
      },
    ],
  },
  {
    id: 'faq-openers',
    heading: 'Openers',
    items: [
      {
        question: 'What\'s the difference between a belt drive and chain drive opener?',
        answer: '<p>Chain drive openers are the most common — durable and affordable, but louder. Belt drive openers run on a rubber belt, making them significantly quieter — a good choice if your garage is attached and below a bedroom. Direct drive openers are the quietest of all, with only one moving part.</p>',
      },
      {
        question: 'How long does a garage door opener last?',
        answer: '<p>Most openers last 10 to 15 years with regular use. Heavy use, poor maintenance, or power surge damage can shorten that. If your opener is over 10 years old and starting to act up, repair costs often approach replacement cost — worth considering an upgrade.</p>',
      },
      {
        question: 'My opener light is flashing. What does that mean?',
        answer: '<p>A flashing opener light is usually a diagnostic code. The number of flashes corresponds to a specific fault — commonly a sensor issue, travel limit problem, or internal error. Count the flashes and check your opener\'s manual, or <a href="/contact">contact us</a> and we can help you decode it.</p>',
      },
      {
        question: 'Should I repair or replace my garage door opener?',
        answer: '<p>If the opener is under 10 years old and the repair is minor, fixing it usually makes sense. If it\'s older than 10 years, frequently acting up, or lacks modern safety features like auto-reverse and rolling code security, replacement is likely the smarter long-term investment.</p>',
      },
    ],
  },
  {
    id: 'faq-installation',
    heading: 'Installation & Products',
    // Hidden by the owner (was commented out) — set hidden: false to show again
    hidden: true,
    items: [
      {
        question: 'Do you install new garage doors?',
        answer: '<p>Yes, we <a href="/services/new-door-installation">install</a> high-quality residential garage doors with expert craftsmanship and attention to detail.</p>',
      },
      {
        question: 'Can I choose a custom style or color?',
        answer: '<p>Absolutely. We offer a wide range of customizable options to match your home\'s architecture and your personal style.</p>',
      },
      {
        question: 'Do you install smart garage door openers?',
        answer: '<p>Yes, we install <a href="/services/new-opener-installation">openers</a> with WiFi and MyQ compatibility for remote access and monitoring. We\'ll help you choose the right model for your needs.</p>',
      },
      {
        question: 'How long does a new garage door installation take?',
        answer: '<p>Most <a href="/services/new-door-installation">installations</a> take half a day to a full day, depending on complexity. We\'ll give you a clear timeline and clean up when finished.</p>',
      },
      {
        question: 'Can I customize the look of my new garage door?',
        answer: '<p>Absolutely. We offer a range of styles, materials, colors, and window options to match your home\'s aesthetic.</p>',
      },
      {
        question: 'What brands do you install or recommend?',
        answer: '<p>We work with quality manufacturers like Amarr, Clopay, and Haas, among others. We\'ll help you choose the right door based on your budget and style.</p>',
      },
      {
        question: 'Is insulation worth it for my garage door?',
        answer: '<p>Yes—especially in Michigan. Insulated doors improve energy efficiency, reduce noise, and help regulate temperatures inside garages used as workshops or living spaces.</p>',
      },
    ],
  },
  {
    id: 'faq-maintenance',
    heading: 'Maintenance & Memberships',
    items: [
      {
        question: 'What\'s included in a maintenance visit?',
        answer: '<p>A typical <a href="/services/maintenance">maintenance</a> visit includes spring tension adjustment, roller and hinge lubrication, safety tests, sensor alignment, and a full system inspection.</p>',
      },
      {
        question: 'How often should I schedule garage door maintenance?',
        answer: '<p>We recommend a professional inspection at least once a year, or twice if your door gets heavy daily use. Preventive <a href="/services/maintenance">maintenance</a> saves money and avoids breakdowns.</p>',
      },
      {
        question: 'What can I do to maintain my garage door between service visits?',
        answer: '<p>A few simple things go a long way: spray the rollers, hinges, and springs with a garage door lubricant (not WD-40) once or twice a year, visually inspect the cables and springs for wear, and test the auto-reverse by placing a 2x4 flat on the ground under the door. If the door doesn\'t reverse on contact, <a href="tel:+19895720303">call</a> us.</p>',
      },
      {
        question: 'Do you offer maintenance plans?',
        answer: '<p>We offer a <a href="/services/performance-membership">Performance Membership</a> instead of traditional maintenance plans. This membership provides ongoing care, priority service, and system protection designed to prevent problems before they happen — not just a once-a-year visit.</p>',
        hidden: true,
      },
      {
        question: 'What does the Performance Membership include?',
        answer: '<p><a href="/services/performance-membership">Performance Members</a> receive scheduled inspections, full safety and mechanical checks, professional lubrication, minor adjustments, priority scheduling, included parts coverage, and exclusive repair discounts. It\'s designed to keep your garage door system operating safely and reliably year-round without you having to think about it.</p>',
        hidden: true,
      },
      {
        question: 'Can I cancel my Performance Membership?',
        answer: '<p>Yes, you can cancel your <a href="/services/performance-membership">Performance Membership</a> after 12 months. Cancelling prior to 12 months may result in additional fees.</p>',
        hidden: true,
      },
    ],
  },
  {
    id: 'faq-pricing',
    heading: 'Pricing & Policies',
    items: [
      {
        question: 'Is there a service call fee?',
        answer: '<p>Yes, there is an $80 service call fee which covers the visit and diagnosis. That fee is applied toward the cost of any repair completed the same day.</p>',
      },
      {
        question: 'Do you provide a written estimate before starting work?',
        answer: '<p>Yes. We always provide a clear estimate before any work begins. You\'ll know exactly what you\'re paying before we pick up a tool.</p>',
      },
      {
        question: 'What are your payment options?',
        answer: '<p>We accept major credit cards, checks, ACH and digital payments. <a href="/services/performance-membership">Performance Memberships</a> will be billed monthly with a card on file.</p>',
      },
      {
        question: 'Do you charge extra for same-day or weekend service?',
        answer: '<p>We don\'t upcharge for same-day service when it\'s available. Emergency appointments may have a small premium, depending on urgency.</p>',
      },
      {
        question: 'What is your service warranty?',
        answer: '<p>We stand by our work with a 1-year labor <a href="/resources/warranty">warranty</a> on most repairs and installations. Product warranties vary by manufacturer.</p>',
      },
      {
        question: 'Will my homeowner\'s insurance cover garage door repairs?',
        answer: '<p>It depends on your policy and the cause of damage. Damage from a covered event like a storm or vehicle impact is often covered, minus your deductible. Wear-and-tear repairs generally aren\'t. Check with your insurer — we can provide documentation if needed for a claim.</p>',
      },
    ],
  },
];
const visibleGroups = groups
  .filter((g) => !g.hidden)
  .map((g) => ({ ...g, items: g.items.filter((i) => !i.hidden) }));
const faqSchema = faqPageSchema(visibleGroups.flatMap((g) => g.items));
---

<BaseLayout {title} {description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <PageHero
    title="Frequently Asked Questions"
    eyebrow="Resources"
    intro="Got questions about your garage door? We've compiled answers to the most common issues, concerns, and curiosities. Whether you're troubleshooting a noisy opener or wondering how often to schedule maintenance, you're in the right place."
    image="/photos/faq-garage-door-image.avif"
    imageAlt="Beginning work on installing a new garage door in Alma"
    crumbs={[{ name: 'Resources', href: '/resources/resources-landing-page' }, { name: 'FAQs', href: '/resources/faq' }]}
  >
    <p class="hero-note">
      Still unsure? Our interactive <a href="/homeowner-tools/ask-abel-ai-assistant#askabel">Garage Door Assistant</a> can help guide you.
    </p>
  </PageHero>

  <!-- Category jump links -->
  <nav class="faq-nav" aria-label="FAQ categories">
    <div class="container cluster cluster--center">
      {visibleGroups.map((g) => (
        <a href={`#${g.id}`} class="chip">{g.heading}</a>
      ))}
    </div>
  </nav>

  <div class="faq-groups">
    {visibleGroups.map((g) => (
      <Faq id={g.id} heading={g.heading} eyebrow={`${g.items.length} questions`} items={g.items} schema={false} />
    ))}
  </div>

  <!-- Still have questions -->
  <section class="section section--sand">
    <div class="container container--narrow text-center stack-lg stack">
      <span class="eyebrow">Get in Touch</span>
      <h2>Still have questions?</h2>
      <p class="lead">
        Still have questions? Try our Garage Door Assistant, <a href="/homeowner-tools/ask-abel-ai-assistant#askabel">Abel</a>, for quick help, or reach out — we're happy to answer any questions you may have.
      </p>
      <div class="technical-contact">
        <a class="contact-row" href={telHref}>
          <span class="contact-row__icon"><Icon name="phone" /></span>
          <span class="method">VOICE</span>
          <span class="contact-row__link">{site.phone.display}</span>
        </a>
        <a class="contact-row" href="/contact#contact-form">
          <span class="contact-row__icon"><Icon name="clipboard" /></span>
          <span class="method">FORM</span>
          <span class="contact-row__link">Fill Out Our Form</span>
        </a>
        <a class="contact-row" href="sms:+19895720303?&body=Hi%2C%20I%20had%20a%20question%20after%20reading%20your%20FAQ.">
          <span class="contact-row__icon"><Icon name="text" /></span>
          <span class="method">MOBILE</span>
          <span class="contact-row__link">Text a Technician</span>
        </a>
        <a class="contact-row" href={mailtoHref}>
          <span class="contact-row__icon"><Icon name="mail" /></span>
          <span class="method">INBOX</span>
          <span class="contact-row__link">Email the Office</span>
        </a>
      </div>
      <div class="cluster cluster--center">
        <a href="/contact" class="btn btn--navy"><Icon name="message" /> Ask a Question</a>
      </div>
    </div>
  </section>

  <AskAbelCard />
  <BookingCta />
  <ContactBlock text="Clear answers. No fluff. Just helpful info from a garage door company that values your time." />
</BaseLayout>

<style>
  .hero-note {
    max-width: 40rem;
  }

  .faq-nav {
    position: relative;
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--line);
    background: var(--white);
  }

  .faq-groups > :global(.faq) {
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem);
    scroll-margin-top: var(--header-h, 70px);
  }

  .faq-groups > :global(.faq:nth-child(even)) {
    background: var(--white);
  }

  .faq-groups :global(.faq .section-head) {
    margin-bottom: var(--space-6);
  }

  .lead a {
    color: var(--bronze-700);
    text-decoration: underline;
  }

  .technical-contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-4);
    text-align: left;
  }

  .contact-row {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'icon method'
      'icon link';
    column-gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    color: var(--navy);
    text-decoration: none;
    transition:
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .contact-row:hover {
    box-shadow: var(--shadow);
    color: var(--navy);
    transform: translateY(-2px);
  }

  .contact-row__icon {
    display: grid;
    grid-area: icon;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    background: var(--bronze-100);
    color: var(--bronze-700);
  }

  .method {
    grid-area: method;
    color: var(--muted);
    font-size: var(--text-xs, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .contact-row__link {
    grid-area: link;
    font-weight: 600;
  }
</style>
