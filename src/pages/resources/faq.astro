---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'FAQs | Isabella Garage Door';
const description = 'Find answers to common questions about garage door repair, installation, maintenance, and more from our experienced team.';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [

    // General Questions
    {
      "@type": "Question",
      "name": "What areas do you service?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We proudly serve Mount Pleasant, Alma, Clare, and surrounding areas in Central Michigan."
      }
    },
    {
      "@type": "Question",
      "name": "What are your business hours?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We typically are available most afternoons."
      }
    },
    {
      "@type": "Question",
      "name": "Are you locally owned?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Isabella Garage Door is a locally owned and family-operated business based in Isabella County, Michigan."
      }
    },
    {
      "@type": "Question",
      "name": "How do I schedule a service call?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The fastest and easiest way to schedule is by booking directly through our online booking page. You can also submit a request through our EasyEstimate tool, or contact us by call, text, email, or our website form."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide same-day service?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In many cases, yes! However it will depend on our current availability."
      }
    },
    {
      "@type": "Question",
      "name": "Are you insured?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Isabella Garage Door is fully insured for residential garage door services. We operate with transparency and uphold all local regulations to protect your home and our work."
      }
    },
    {
      "@type": "Question",
      "name": "How quickly can I expect a response?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We typically respond the same day — often within a few hours."
      }
    },
    {
      "@type": "Question",
      "name": "Do you only work on certain brands?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No — we service all major residential garage door and opener brands regardless of who installed them originally."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to be home for the service call?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For most repairs, yes — we'll need access to the garage and prefer to walk you through the work when finished. If your situation is unique, reach out and we can discuss options."
      }
    },
    {
      "@type": "Question",
      "name": "Will you explain what's wrong before doing any work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Always. We diagnose the problem first, explain what we found, and give you a clear price before touching anything. No surprises."
      }
    },

    // General - new additions
    {
      "@type": "Question",
      "name": "Do you work on commercial garage doors?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No — we specialize exclusively in residential garage doors and openers. If you need commercial service, we recommend contacting a commercial door specialist."
      }
    },
    {
      "@type": "Question",
      "name": "Can you tell me over the phone what's wrong with my door?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sometimes. If you describe the symptoms, we can often give you a good idea of what's going on and whether it's urgent. You can also use our DoorDiagnosis tool online. But an accurate diagnosis really requires seeing the door in person — there's a lot we can miss without being there."
      }
    },

    // Repairs & Service
    {
      "@type": "Question",
      "name": "How much does it cost to fix a broken garage door spring?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The cost varies depending on the size and weight of your door, but you can get a ballpark price in under 60 seconds using our EasyEstimate tool. We focus on value by using high-cycle springs that last twice as long as standard ones."
      }
    },
    {
      "@type": "Question",
      "name": "My door won't open. Should I try to fix it myself?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If you hear a loud bang or see a gap in your spring, do not attempt to open the door. Garage door springs are under extreme tension and can be dangerous. It is best to keep the door closed and call a professional for a safe repair."
      }
    },
    {
      "@type": "Question",
      "name": "My garage door is making a loud grinding or squeaking noise. Is that serious?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not always — sometimes it just needs lubrication. But grinding can also indicate worn rollers, loose hardware, or a failing opener gear. If the noise is new or getting worse, it's worth having it looked at before a small issue becomes a bigger repair."
      }
    },
    {
      "@type": "Question",
      "name": "My door opens but won't close all the way. What's causing that?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "This is usually a safety sensor issue. The sensors at the bottom of your door tracks need to be aligned and unobstructed. It can also be a travel limit setting on the opener. Both are straightforward fixes."
      }
    },
    {
      "@type": "Question",
      "name": "How long do garage door springs last?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard springs are rated for around 10,000 cycles — roughly 7 to 10 years with average use. High-cycle springs are rated for 25,000+ cycles, which significantly extends the life of your system."
      }
    },
    {
      "@type": "Question",
      "name": "Can you repair broken garage door panels?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In some cases, yes — especially if the damage is cosmetic or isolated. We'll let you know whether a repair or panel replacement makes more sense."
      }
    },
    {
      "@type": "Question",
      "name": "My opener works but the door doesn't move. What's wrong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "This could be a broken spring or disconnected drive mechanism. We'll assess and fix the issue safely — never try to force the door open yourself."
      }
    },
    {
      "@type": "Question",
      "name": "My garage door goes back up right after it closes. What's going on?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "That's almost always the safety sensors detecting something in the path — real or imagined. Misaligned sensors, a dirty sensor lens, or direct sunlight interference can all trigger it. It's a quick fix in most cases."
      }
    },
    {
      "@type": "Question",
      "name": "My remote stopped working. Do I need a new opener?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Probably not. Start with fresh batteries. If that doesn't fix it, the remote may need to be reprogrammed or replaced — both inexpensive fixes. A new opener is rarely the answer for a remote issue alone."
      }
    },
    {
      "@type": "Question",
      "name": "Is it safe to use my garage door if a spring is broken?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. A broken spring puts enormous strain on your opener and cables, and the door can drop unexpectedly. Keep it closed and call us — this is one repair you don't want to delay."
      }
    },
    {
      "@type": "Question",
      "name": "My garage door is off its tracks. Can I fix it myself?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We strongly advise against it. A door off its tracks is under uneven tension and can fall without warning. It's one of the more dangerous DIY attempts we see go wrong. Call us and keep the door where it is until we arrive."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a typical garage door repair take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most common repairs take about an hour, sometimes two. More involved jobs may take a bit longer. We'll give you a time estimate before we start."
      }
    },
    {
      "@type": "Question",
      "name": "One side of my garage door looks crooked or uneven. What's wrong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An uneven door usually means one spring has broken or lost tension, or a cable has come off the drum. Either way, don't force it — operating the door in that condition can cause further damage or injury."
      }
    },
    {
      "@type": "Question",
      "name": "How do I know if I need a repair or a full replacement?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on the age of the door and opener, the extent of the damage, and what a repair would cost relative to replacement. We'll always give you an honest recommendation — if a repair makes more sense, we'll say so. If the door is at the end of its life, we'll tell you that too."
      }
    },

    // Safety
    {
      "@type": "Question",
      "name": "How do I test if my garage door's auto-reverse is working?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Place a 2x4 flat on the ground in the center of the door opening. Close the door — it should reverse automatically when it contacts the board. If it doesn't, your auto-reverse needs adjustment. This is a critical safety feature, especially if you have children or pets."
      }
    },
    {
      "@type": "Question",
      "name": "My garage door came down on my car. What should I do?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Don't try to force the door back up manually. If the door came off track or the cables came off the drum DO NOT go near it! Call us — we'll get there quickly and handle it without causing additional damage to your car or the door system."
      }
    },
    {
      "@type": "Question",
      "name": "Is my old garage door opener safe?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Openers made before 1993 don't have the auto-reverse feature required by law today, which means they can close on people, pets, or objects without stopping. If your opener is more than 20-25 years old, replacement is worth serious consideration for safety alone."
      }
    },
    {
      "@type": "Question",
      "name": "Can a garage door opener be hacked?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Older openers using fixed-code remotes can be vulnerable to signal capture. Modern openers use rolling code technology that changes with every use, making them significantly more secure. If your opener is old, this is one more reason to consider an upgrade."
      }
    },

    // Weather & Michigan-Specific
    {
      "@type": "Question",
      "name": "Why does my garage door struggle to open in cold weather?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Cold temperatures cause metal components to contract and lubricants to thicken, which increases resistance throughout the system. Springs especially lose efficiency in the cold. A pre-winter tune-up with the right lubricant can make a noticeable difference."
      }
    },
    {
      "@type": "Question",
      "name": "My garage door froze to the ground overnight. What do I do?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Don't force it with the opener — you can burn out the motor. Use a hair dryer along the bottom seal to melt the ice. Once it's free, apply a silicone-based lubricant to the bottom seal to help prevent it from happening again."
      }
    },
    {
      "@type": "Question",
      "name": "Should I insulate my garage door for Michigan winters?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If you use your garage for anything beyond parking — a workshop, storage, laundry — insulation is worth it. It keeps temps more stable, reduces strain on the opener in cold weather, and cuts down on noise. Michigan winters are hard on uninsulated doors."
      }
    },
    {
      "@type": "Question",
      "name": "How does humidity affect my garage door?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "High humidity can cause wooden doors to swell and warp, and accelerate rust on springs, cables, and hardware. It can also affect sensor performance. Keeping your door lubricated and ensuring good weatherstripping goes a long way in Michigan's humid summers."
      }
    },

    // Openers
    {
      "@type": "Question",
      "name": "What's the difference between a belt drive and chain drive opener?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Chain drive openers are the most common — durable and affordable, but louder. Belt drive openers run on a rubber belt, making them significantly quieter — a good choice if your garage is attached and below a bedroom. Direct drive openers are the quietest of all, with only one moving part."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a garage door opener last?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most openers last 10 to 15 years with regular use. Heavy use, poor maintenance, or power surge damage can shorten that. If your opener is over 10 years old and starting to act up, repair costs often approach replacement cost — worth considering an upgrade."
      }
    },
    {
      "@type": "Question",
      "name": "My opener light is flashing. What does that mean?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A flashing opener light is usually a diagnostic code. The number of flashes corresponds to a specific fault — commonly a sensor issue, travel limit problem, or internal error. Count the flashes and check your opener's manual, or contact us and we can help you decode it."
      }
    },
    {
      "@type": "Question",
      "name": "Should I repair or replace my garage door opener?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If the opener is under 10 years old and the repair is minor, fixing it usually makes sense. If it's older than 10 years, frequently acting up, or lacks modern safety features like auto-reverse and rolling code security, replacement is likely the smarter long-term investment."
      }
    },

    // Pricing - new additions
    {
      "@type": "Question",
      "name": "Will my homeowner's insurance cover garage door repairs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on your policy and the cause of damage. Damage from a covered event like a storm or vehicle impact is often covered, minus your deductible. Wear-and-tear repairs generally aren't. Check with your insurer — we can provide documentation if needed for a claim."
      }
    },

    // Maintenance & Memberships
    {
      "@type": "Question",
      "name": "What's included in a maintenance visit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A typical maintenance visit includes spring tension adjustment, roller and hinge lubrication, safety tests, sensor alignment, and a full system inspection."
      }
    },
    {
      "@type": "Question",
      "name": "How often should I schedule garage door maintenance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We recommend a professional inspection at least once a year, or twice if your door gets heavy daily use. Preventive maintenance saves money and avoids breakdowns."
      }
    },
    {
      "@type": "Question",
      "name": "What can I do to maintain my garage door between service visits?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A few simple things go a long way: spray the rollers, hinges, and springs with a garage door lubricant (not WD-40) once or twice a year, visually inspect the cables and springs for wear, and test the auto-reverse by placing a 2x4 flat on the ground under the door. If the door doesn't reverse on contact, call us."
      }
    },

    // Pricing & Policies
    {
      "@type": "Question",
      "name": "What are your payment options?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We accept major credit cards, checks, ACH and digital payments."
      }
    },
    {
      "@type": "Question",
      "name": "Do you charge extra for same-day or weekend service?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We don't upcharge for same-day service when it's available. Emergency appointments may have a small premium, depending on urgency."
      }
    },
    {
      "@type": "Question",
      "name": "What is your service warranty?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We stand by our work with a 1-year labor warranty on most repairs and installations. Product warranties vary by manufacturer."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a service call fee?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, there is a $75 service call fee which covers the visit and diagnosis. That fee is applied toward the cost of any repair completed the same day."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide a written estimate before starting work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We always provide a clear estimate before any work begins. You'll know exactly what you're paying before we pick up a tool."
      }
    }
  ]
};
---

<BaseLayout {title} {description}>

<Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

<style>
.faq-page {
  max-width: 1200px;
  margin: 0 auto;
  content-align: center;
}

.faq-intro p {
  font-size: 1.1rem;
  line-height: 1.6;
  margin: 1rem auto 0;
  color: #333;
}

.faq-outro p {
  font-size: 1.1rem;
  line-height: 1.6;
  margin: 3rem auto 2rem;
  color: #333;
}

.faq-link {
  color: #b27d57;
  font-weight: bold;
  text-decoration: underline;
}

.faq-link:hover {
  color: #81583b;
}

.faq-answer a {
  color: #b27d57;
  text-decoration: none;
}

.faq-answer a:hover {
  text-decoration: underline;
}
</style>

  <img src="/photos/faq-garage-door-image.avif" alt="Beginning work on installing a new garage door in Alma" loading="eager" fetchpriority="high" class="header-photo-interior" />

<section class="faq-page">

    <section class="faq-intro">
      <h1 class="page-title">Frequently Asked Questions</h1>
      <p>
        Got questions about your garage door? We've compiled answers to the most common issues, concerns, and curiosities. Whether you're troubleshooting a noisy opener or wondering how often to schedule maintenance, you're in the right place.
      </p>
      <p>
        Still unsure? Our interactive <a href="/homeowner-tools/ask-abel-ai-assistant#askabel" class="faq-link">Garage Door Assistant</a> can help guide you.
      </p>
    </section>


<!-- FAQ -->

<section id="faq">

  <!-- START FAQ ITEMS -->

  <!-- General Questions -->
<div class="faq-head">
<h2 class="sub-heading" style="margin-bottom: -.5rem;">General Questions</h2>
</div>
  <div class="faq-item"><div class="faq-question"><span>What areas do you service?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>We proudly serve <a href="/locations/mt-pleasant">Mount Pleasant</a>, <a href="/locations/alma">Alma</a>, <a href="/locations/clare">Clare</a>, and surrounding areas in <a href="/locations/central-michigan">Central Michigan</a>.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>What are your business hours?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>We typically are available most afternoons.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>Are you locally owned?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Yes! Isabella Garage Door is a locally owned and family-operated business based in <a href="/locations/isabella-county">Isabella County</a>, Michigan.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>How do I schedule a service call?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>The fastest and easiest way to schedule is by booking directly through our <a href="/booking">online booking page</a>. You can also submit a request through our <a href="/homeowner-tools/easy-estimate">EasyEstimate tool</a>, or contact us by <a href="tel:19895720303">call</a>, <a href="sms:19895720303">text</a>, <a href="mailto:isabellagaragedoor@gmail.com">email</a>, or our <a href="/contact">website form</a>.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>Do you provide same-day service?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>In many cases, yes! However it will depend on our current availability.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>Are you insured?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Yes. Isabella Garage Door is fully insured for residential garage door services. We operate with transparency and uphold all local regulations to protect your home and our work.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>How quickly can I expect a response?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>We typically respond the same day — often within a few hours.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>Do you only work on certain brands?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>No — we service all major residential garage door and opener brands regardless of who installed them originally.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>Do I need to be home for the service call?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>For most repairs, yes — we'll need access to the garage and prefer to walk you through the work when finished. If your situation is unique, reach out and we can discuss options.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>Will you explain what's wrong before doing any work?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Always. We diagnose the problem first, explain what we found, and give you a clear price before touching anything. No surprises.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>Do you work on commercial garage doors?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>No — we specialize exclusively in residential garage doors and openers. If you need commercial service, we recommend contacting a commercial door specialist.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>Can you tell me over the phone what's wrong with my door?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Sometimes. If you describe the symptoms, we can often give you a good idea of what's going on and whether it's urgent. You can also use our <a href="/homeowner-tools/door-diagnosis">DoorDiagnosis tool</a> online, But an accurate diagnosis really requires seeing the door in person — there's a lot we can miss without being there.</p></div></div>
</section>

<div style="height: 2px; background-color: #ccc; margin: 2rem 0;"></div>

  <!-- Repairs & Service -->
<section id="faq-repairs" style="margin: 2rem auto 2rem;">
<div class="faq-head">
<h2 class="sub-heading" style="margin-bottom: -.5rem;">Repairs & Service</h2>
</div>
  <div class="faq-item"><div class="faq-question"><span>How much does it cost to fix a broken garage door spring?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>The cost varies depending on the size and weight of your door, but you can get a ballpark price in under 60 seconds using our <a href="/homeowner-tools/easy-estimate">EasyEstimate™ tool</a>. We focus on value by using high-cycle springs that last twice as long as standard ones.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>My door won't open. Should I try to fix it myself?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>If you hear a loud bang or see a gap in your spring, do not attempt to open the door. Garage door springs are under extreme tension and can be dangerous. It is best to keep the door closed and call a professional for a safe repair.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>My garage door is making a loud grinding or squeaking noise. Is that serious?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Not always — sometimes it just needs lubrication. But grinding can also indicate worn rollers, loose hardware, or a failing opener gear. If the noise is new or getting worse, it's worth having it looked at before a small issue becomes a bigger repair.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>My door opens but won't close all the way. What's causing that?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>This is usually a safety sensor issue. The sensors at the bottom of your door tracks need to be aligned and unobstructed. It can also be a travel limit setting on the opener. Both are straightforward fixes.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>My garage door goes back up right after it closes. What's going on?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>That's almost always the safety sensors detecting something in the path — real or imagined. Misaligned sensors, a dirty sensor lens, or direct sunlight interference can all trigger it. It's a quick fix in most cases.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>My remote stopped working. Do I need a new opener?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Probably not. Start with fresh batteries. If that doesn't fix it, the remote may need to be reprogrammed or replaced — both inexpensive fixes. A new opener is rarely the answer for a remote issue alone.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>How long do garage door springs last?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Standard springs are rated for around 10,000 cycles — roughly 7 to 10 years with average use. High-cycle springs are rated for 25,000+ cycles, which significantly extends the life of your system.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>Can you repair broken garage door panels?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>In some cases, yes — especially if the damage is cosmetic or isolated. We'll let you know whether a repair or panel replacement makes more sense.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>My opener works but the door doesn't move. What's wrong?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>This could be a <a href="/services/broken-springs">broken spring</a> or disconnected drive mechanism. We'll assess and fix the issue safely — never try to force the door open yourself.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>Is it safe to use my garage door if a spring is broken?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>No. A <a href="/services/broken-springs">broken spring</a> puts enormous strain on your opener and cables, and the door can drop unexpectedly. Keep it closed and <a href="/contact#contact-form">contact us</a> — this is one repair you don't want to delay.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>My garage door is off its tracks. Can I fix it myself?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>We strongly advise against it. A door off its tracks is under uneven tension and can fall without warning. It's one of the more dangerous DIY attempts we see go wrong. <a href="tel:9895720303">Call</a> us and keep the door where it is until we arrive.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>How long does a typical garage door repair take?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Most common repairs take about an hour, sometimes two. More involved jobs may take a bit longer. We'll give you a time estimate before we start.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>One side of my garage door looks crooked or uneven. What's wrong?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>An uneven door usually means one spring has broken or lost tension, or a cable has come off the drum. Either way, don't force it — operating the door in that condition can cause further damage or injury.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>How do I know if I need a repair or a full replacement?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>It depends on the age of the door and opener, the extent of the damage, and what a repair would cost relative to replacement. We'll always give you an honest recommendation — if a repair makes more sense, we'll say so. If the door is at the end of its life, we'll tell you that too.</p></div></div>
</section>

<div style="height: 2px; background-color: #ccc; margin: 2rem 0;"></div>

  <!-- Safety -->
<section id="faq-safety" style="margin: 2rem auto 2rem;">
<div class="faq-head">
<h2 class="sub-heading" style="margin-bottom: -.5rem;">Safety</h2>
</div>
  <div class="faq-item"><div class="faq-question"><span>How do I test if my garage door's auto-reverse is working?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Place a 2x4 flat on the ground in the center of the door opening. Close the door — it should reverse automatically when it contacts the board. If it doesn't, your auto-reverse needs adjustment. This is a critical safety feature, especially if you have children or pets.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>My garage door came down on my car. What should I do?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Don't try to force the door back up manually. If the door came off track or the cables came off the drum DO NOT go near it! <a href="tel:9895720303">Call</a> us — we'll get there quickly and handle it without causing additional damage to your car or the door system.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>Is my old garage door opener safe?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Openers made before 1993 don't have the auto-reverse feature required by law today, which means they can close on people, pets, or objects without stopping. If your opener is more than 20–25 years old, replacement is worth serious consideration for safety alone.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>Can a garage door opener be hacked?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Older openers using fixed-code remotes can be vulnerable to signal capture. Modern openers use rolling code technology that changes with every use, making them significantly more secure. If your opener is old, this is one more reason to consider an upgrade.</p></div></div>
</section>

<div style="height: 2px; background-color: #ccc; margin: 2rem 0;"></div>

  <!-- Weather & Michigan-Specific -->
<section id="faq-weather" style="margin: 2rem auto 2rem;">
<div class="faq-head">
<h2 class="sub-heading" style="margin-bottom: -.5rem;">Weather & Michigan winters</h2>
</div>
  <div class="faq-item"><div class="faq-question"><span>Why does my garage door struggle to open in cold weather?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Cold temperatures cause metal components to contract and lubricants to thicken, which increases resistance throughout the system. Springs especially lose efficiency in the cold. A pre-winter tune-up with the right lubricant can make a noticeable difference.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>My garage door froze to the ground overnight. What do I do?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Don't force it with the opener — you can burn out the motor. Use a hair dryer along the bottom seal to melt the ice. Once it's free, apply a silicone-based lubricant to the bottom seal to help prevent it from happening again.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>Should I insulate my garage door for Michigan winters?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>If you use your garage for anything beyond parking — a workshop, storage, laundry — insulation is worth it. It keeps temps more stable, reduces strain on the opener in cold weather, and cuts down on noise. Michigan winters are hard on uninsulated doors.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>How does humidity affect my garage door?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>High humidity can cause wooden doors to swell and warp, and accelerate rust on springs, cables, and hardware. It can also affect sensor performance. Keeping your door lubricated and ensuring good weatherstripping goes a long way in Michigan's humid summers.</p></div></div>
</section>

<div style="height: 2px; background-color: #ccc; margin: 2rem 0;"></div>

  <!-- Openers -->
<section id="faq-openers" style="margin: 2rem auto 2rem;">
<div class="faq-head">
<h2 class="sub-heading" style="margin-bottom: -.5rem;">Openers</h2>
</div>
  <div class="faq-item"><div class="faq-question"><span>What's the difference between a belt drive and chain drive opener?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Chain drive openers are the most common — durable and affordable, but louder. Belt drive openers run on a rubber belt, making them significantly quieter — a good choice if your garage is attached and below a bedroom. Direct drive openers are the quietest of all, with only one moving part.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>How long does a garage door opener last?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>Most openers last 10 to 15 years with regular use. Heavy use, poor maintenance, or power surge damage can shorten that. If your opener is over 10 years old and starting to act up, repair costs often approach replacement cost — worth considering an upgrade.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>My opener light is flashing. What does that mean?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>A flashing opener light is usually a diagnostic code. The number of flashes corresponds to a specific fault — commonly a sensor issue, travel limit problem, or internal error. Count the flashes and check your opener's manual, or <a href="/contact">contact us</a> and we can help you decode it.</p></div></div>
  <div class="faq-item"><div class="faq-question"><span>Should I repair or replace my garage door opener?</span><span class="faq-arrow">&#9654;</span></div><div class="faq-answer"><p>If the opener is under 10 years old and the repair is minor, fixing it usually makes sense. If it's older than 10 years, frequently acting up, or lacks modern safety features like auto-reverse and rolling code security, replacement is likely the smarter long-term investment.</p></div></div>
</section>

