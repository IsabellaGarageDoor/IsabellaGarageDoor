---
// QR / NFC landing page (printed on cards and stickers) — the URL must not change.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import { site } from '../../config/site';
const title = "Save My Contact - Isabella Garage Door";
const description = "Save Isabella Garage Door to your contacts for warranty support, and leave a Google review if you loved your service.";
---

<BaseLayout {title} {description} legacy={false}>

  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <section class="save-page">
    <div class="save-card">

      <header class="save-card__header">
        <img class="save-card__logo" src={site.logo.white} alt="" width="160" height="64" />
        <div class="save-card__title">
          <h1>Isabella Garage Door</h1>
          <p>Garage Door Repair &amp; Service</p>
        </div>
      </header>

      <div class="save-card__body">
        <div class="save-card__greeting">
          <p>
            Thank you for choosing Isabella Garage Door. Save our contact below — you'll have everything you need if a warranty question ever comes up.
          </p>

          <p>
            Help other homeowners discover Isabella Garage Door with a quick Google review.
          </p>
        </div>
