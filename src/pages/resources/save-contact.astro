          <div class="save-contact-row">
            <svg viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
            <a href="tel:+19895720303" class="strip-link"><span>989-572-0303</span></a>
          </div>
          <div class="save-contact-row">
            <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
            <a href="https://isabellagaragedoor.com" target="_blank" rel="noopener noreferrer" class="strip-link"><span>isabellagaragedoor.com</span></a>
          </div>
          <div class="save-contact-row">
            <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <span>Rosebush, MI</span>
          </div>
        </div>
-->
        <a href="/isabella-garage-door.vcf" class="save-btn save-btn--primary">
          <Icon name="user" size="1.35em" />
          Save to My Contacts
        </a>

        <div class="save-divider"><span>Had a great experience?</span></div>

        <a
          class="save-btn save-btn--review"
          href="https://g.page/r/Cf6x4Aq_rhM5EBM/review"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="star" size="1.35em" />
          Leave a Google Review
        </a>

        <div class="save-divider save-divider--plain"><span></span></div>

        <a class="warranty-link" href="/resources/warranty">
          <Icon name="shield" size="1.15em" />
          View Warranty Information
        </a>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .save-page {
    padding: clamp(1.25rem, 0.5rem + 4vw, 4rem) var(--gutter) clamp(2rem, 1rem + 4vw, 5rem);
    background:
      radial-gradient(circle at 50% 0%, rgb(178 125 87 / 0.16), transparent 55%),
      var(--sand);
  }

  .save-card {
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-lg);
  }

  .save-card__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-6) var(--space-6);
    border-bottom: 4px solid var(--bronze);
    background:
      radial-gradient(circle at 100% 0%, rgb(178 125 87 / 0.22), transparent 50%),
      linear-gradient(160deg, var(--navy) 0%, var(--navy-800) 100%);
    text-align: center;
  }

  .save-card__logo {
    width: auto;
    height: 56px;
  }

  .save-card__title h1 {
    color: var(--white);
    font-size: 1.6rem;
  }

  .save-card__title p {
    margin-top: var(--space-1);
    color: var(--bronze-300);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .save-card__body {
    padding: var(--space-6);
  }

  .save-card__greeting {
    margin-bottom: var(--space-6);
    padding-left: var(--space-4);
    border-left: 3px solid var(--bronze);
    color: var(--text);
  }

  .save-card__greeting p + p {
    margin-top: var(--space-3);
  }

  .save-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    width: 100%;
    min-height: 60px;
    padding: 0.9rem 1.25rem;
    border-radius: var(--radius);
    color: var(--white);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition:
      background-color var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .save-btn:hover {
    color: var(--white);
  }

  .save-btn:active {
    transform: scale(0.98);
  }

  .save-btn--primary {
    background: var(--navy);
    box-shadow: 0 8px 20px rgb(26 51 79 / 0.25);
  }

  .save-btn--primary:hover {
    background: var(--navy-700);
  }

  .save-btn--review {
    background: var(--bronze-600);
    box-shadow: 0 8px 20px rgb(154 103 68 / 0.25);
  }

  .save-btn--review:hover {
    background: var(--bronze-700);
  }

  .save-divider {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-6) 0 var(--space-4);
  }

  .save-divider::before,
  .save-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .save-divider span {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .save-divider--plain {
    gap: 0;
  }

  .warranty-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    color: var(--navy);
    font-weight: 500;
    text-decoration: none;
  }

  .warranty-link :global(.icon) {
    color: var(--bronze-600);
  }

  .warranty-link:hover {
    background: var(--bronze-50);
    color: var(--navy);
  }
</style>
