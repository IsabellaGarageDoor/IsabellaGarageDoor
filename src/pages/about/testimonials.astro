---
title: "Testimonials - Isabella Garage Door"
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Paginate from '../../components/Paginate.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import BookingCta from '../../components/BookingCta.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Icon from '../../components/ui/Icon.astro';
import { reviewsNewestFirst } from '../../data/reviews';
import { site } from '../../config/site';

const title = 'Testimonials | Isabella Garage Door';
const description = 'Hear from our satisfied customers across Central Michigan and discover why Isabella Garage Door is the trusted choice for garage door service.';

// Reviews live in src/data/reviews.ts (newest first here).
// Pagination happens in the browser (?page=N) — see components/Paginate.astro
const perPage = 5;

const pageUrl = 'https://isabellagaragedoor.com/about/testimonials';

const testimonialsSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemPage",
      "@id": pageUrl,
      "url": pageUrl,
      "name": "Customer Testimonials | Isabella Garage Door",
      "description": "Read reviews from satisfied homeowners across Central Michigan who chose Isabella Garage Door for fast, honest, and reliable repair service.",
      "mainEntity": {
        "@id": "https://isabellagaragedoor.com/#business"
      }
    },
    ...reviewsNewestFirst.map((review, index) => ({
      "@type": "Review",
      "@id": `${pageUrl}#review-${index}`,
      "itemReviewed": {
        "@id": "https://isabellagaragedoor.com/#business"
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": review.rating.toString(),
        "bestRating": "5"
      },
      "author": {
        "@type": "Person",
        "name": review.author
      },
      "reviewBody": review.quote,
      "datePublished": review.date
    }))
  ]
};
---

<BaseLayout {title} {description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(testimonialsSchema)} />
  </Fragment>

  <PageHero
    title="What Our Customers Are Saying"
    eyebrow="Testimonials"
    intro="We don’t just fix garage doors — we build trust. Homeowners in Mt. Pleasant, Alma, Clare, Isabella County, and across Central Michigan say it best:"
    image="/photos/happy-family-garage-door.avif"
    imageAlt="The-best-garage-door-installation-Mount-Pleasant-Michigan"
    crumbs={[{ name: 'Testimonials', href: '/about/testimonials' }]}
  >
    <Fragment slot="actions">
      <a href="#share-review" class="btn btn--primary"><Icon name="star" /> Share Your Experience</a>
      <a href="/booking" class="btn btn--outline-light"><Icon name="calendar" /> Schedule Service</a>
    </Fragment>
  </PageHero>

  <section class="section section--sand">
    <div class="container reviews-wrap">
      <div id="reviews"></div>
      <Paginate perPage={perPage} anchor="reviews" class="reviews-list">
        {reviewsNewestFirst.map((review) => (
          <div><TestimonialCard quote={review.quote} author={review.author} rating={review.rating ?? 5} /></div>
        ))}
      </Paginate>
    </div>
  </section>

  <section class="section" id="share-review">
    <div class="container container--narrow">
      <div class="form-card">
        <div class="section-head">
          <span class="eyebrow">Leave a Review</span>
          <h2>Want to share your experience?</h2>
          <p>We'd love to hear how we did. Your feedback helps others know what to expect from our service.</p>
        </div>

        <form
          id="testimonialsForm"
          name="testimonials"
          method="POST"
          action="https://api.web3forms.com/submit"
          class="testimonial-form"
        >
          <input type="hidden" name="access_key" value="f356bda4-8613-4c1d-92cc-43871d5e272b" />
          <input type="hidden" name="subject" value="New Testimonial Submission - Isabella Garage Door" />
          <input type="hidden" name="redirect" value="https://isabellagaragedoor.com/thank-you-estimate" />
          <input type="checkbox" name="botcheck" style="display: none;" />

          <div class="field-row">
            <div class="field">
              <label for="name">Your Name</label>
              <input type="text" id="name" name="name" placeholder="John D." required />
            </div>

            <div class="field">
              <label for="rating">Star Rating</label>
              <select id="rating" name="rating" required>
                <option value="">Select</option>
                <option value="5">★★★★★ (5 - Excellent)</option>
                <option value="4">★★★★☆ (4 - Very good)</option>
                <option value="3">★★★☆☆ (3 - Average)</option>
                <option value="2">★★☆☆☆ (2 - Needs work)</option>
                <option value="1">★☆☆☆☆ (1 - Poor)</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="quote">Your Review</label>
            <textarea id="quote" name="quote" rows="4" required placeholder="Tell us about your experience..."></textarea>
          </div>

          <div class="form-button-wrapper">
            <button type="submit" class="btn btn--navy btn--lg">Send Review</button>
          </div>
        </form>

        <p class="google-review-link">
          Prefer to leave a review on <a href={site.social.googleReview} target="_blank" rel="noopener">Google</a>?
        </p>
      </div>

      <div class="cluster cluster--center mt-10">
        <a href="/booking" class="btn btn--primary"><Icon name="calendar" /> Schedule Service</a>
      </div>
    </div>
  </section>

  <BookingCta />
  <ContactBlock text="Real feedback from real customers—we're proud to serve Central Michigan with service people remember." />
</BaseLayout>

<style>
  #reviews {
    scroll-margin-top: calc(var(--header-h, 70px) + 1.5rem);
  }

  .reviews-wrap :global(.reviews-list) {
    display: grid;
    gap: var(--space-6);
  }

  .reviews-wrap :global(.reviews-list > [hidden]) {
    display: none;
  }

  .reviews-wrap :global(.pagination-wrapper) {
    margin-top: var(--space-10);
  }

  .form-card {
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    border: 1px solid var(--line);
    border-top: 4px solid var(--bronze);
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--shadow);
  }

  .form-card .section-head {
    margin-bottom: var(--space-8);
  }

  .testimonial-form {
    display: grid;
    gap: var(--space-5);
  }

  .field-row {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field label {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--navy);
    font-weight: 600;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm, 0.5rem);
    background: var(--white);
    color: var(--ink);
    font: inherit;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--bronze);
    outline: 2px solid var(--bronze-100);
  }

  .field textarea {
    resize: vertical;
  }

  .form-button-wrapper {
    display: flex;
    justify-content: center;
    padding-top: var(--space-2);
  }

  .google-review-link {
    margin-top: var(--space-6);
    color: var(--muted);
    text-align: center;
  }

  .google-review-link a {
    color: var(--bronze-700);
    font-weight: 600;
    text-decoration: underline;
  }
</style>
