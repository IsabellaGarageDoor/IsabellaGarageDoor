---
title: "About Us - Isabella Garage Door"
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import BookingCta from '../../components/BookingCta.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Icon from '../../components/ui/Icon.astro';

const title = 'Our Story | Isabella Garage Door';
const description = 'Learn how our family-run garage door company in Mt. Pleasant is raising service standards in Central Michigan.';

const ourStorySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": "https://isabellagaragedoor.com/about/our-story",
      "url": "https://isabellagaragedoor.com/about/our-story",
      "name": "The Isabella Garage Door Story",
      "description": "The history and core values of Isabella Garage Door, a family-owned repair and installation company serving Central Michigan.",
      "mainEntity": {
        "@id": "https://isabellagaragedoor.com/#business"
      },
      "knowsAbout": [
        "Garage Door Repair",
        "Torsion Spring Replacement",
        "Garage Door Installation",
        "Preventative Maintenance"
      ],
      "specialty": "High-cycle spring upgrades and emergency garage door repair"
    }
  ]
};

const values = [
  { href: '#craftsmanship', icon: 'tools', title: 'Craftsmanship', text: 'Every repair <!--and installation--> reflects our pride in quality workmanship.' },
  { href: '#integrity', icon: 'handshake', title: 'Integrity', text: 'Honest recommendations and fair pricing—always.' },
  { href: '#reliability', icon: 'clock', title: 'Reliability', text: 'We show up on time and follow through with every detail.' },
  { href: '#community', icon: 'users', title: 'Community', text: 'We live here, work here, and care deeply about our neighbors.' },
];
---

<BaseLayout {title} {description} legacy={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(ourStorySchema)} />
  </Fragment>

  <PageHero
    title="Service You Can Trust"
    eyebrow="Our Story"
    image="/photos/isabella-garage-door-about-us-img.webp"
    imageAlt="A quiet Central Michigan neighborhood with attached garages on residential homes"
    crumbs={[{ name: 'Our Story', href: '/about/our-story' }]}
    intro="At Isabella Garage Door, we believe exceptional service means more than just getting the job done—it’s about building lasting relationships through quality workmanship, honest communication, and genuine care for our community."
  >
    <p class="hero-sub">
      As a locally owned and operated company in Isabella County, we specialize in garage door repair <!--,
      installation,--> and maintenance. <!-- Whether it’s routine maintenance or a custom installation, -->
      Every project reflects our dedication to craftsmanship and service that exceeds expectations.
    </p>
    <Fragment slot="actions">
      <a href="/contact" class="btn btn--primary"><Icon name="handshake" /> Get in Touch</a>
      <a href="#integrity" class="btn btn--outline-light">Our Values</a>
    </Fragment>
  </PageHero>

  <!-- Direct, personal service -->
  <section class="section anchor-target" id="integrity">
    <div class="container container--narrow text-center stack-lg stack">
      <span class="eyebrow">How We Work</span>
      <h2>Direct, Personal Service</h2>
      <p class="lead">
        When you choose Isabella Garage Door, you work directly with experienced technicians who take personal
        ownership of your project. No call centers, no subcontractors, and no high-pressure sales tactics—just
        straightforward advice, clear communication, and results that exceed your expectations.
      </p>
    </div>
  </section>

  <!-- Values -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our Values</span>
        <h2>Built on Values That Matter</h2>
      </div>
      <div class="grid grid--4 values">
        {values.map((v) => (
          <a href={v.href} class="card card--link value-card reveal">
            <span class="card__icon"><Icon name={v.icon} /></span>
            <h3>{v.title}</h3>
            <p set:html={v.text} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Commitment + solutions -->
  <section class="section">
    <div class="container grid grid--2 story-pair">
      <div class="stack anchor-target" id="craftsmanship">
        <span class="eyebrow">Craftsmanship</span>
        <h2>Our Commitment to Excellence</h2>
        <p>
          Our guiding principle drives everything we do: <em>Raising Performance. Elevating Standards.</em> From timely arrivals and meticulous installations to comprehensive follow-up care, we focus
          on the details that truly matter. We believe professionalism means more than just technical
          expertise—it’s about how we treat your home, how we communicate throughout the process,
          and the pride we take in delivering exceptional results.
        </p>
      </div>
      <div class="stack anchor-target" id="reliability">
        <span class="eyebrow">Reliability</span>
        <h2>Complete Garage Door Solutions</h2>
        <p>
          Whether you're enhancing your home's curb appeal, addressing an unexpected repair, or staying ahead with preventative
          maintenance, Isabella Garage Door is here to provide outstanding service with a personal touch.
          We’re honored to serve our neighbors—and strive to be the garage door company you proudly recommend to family and friends.
        </p>
      </div>
    </div>
  </section>

  <!-- Highlight -->
  <section class="section section--tight">
    <div class="container">
      <div class="highlight reveal">
        <Icon name="home" class="highlight__icon" size="2rem" />
        <p>
          Isabella Garage Door is a <strong>family-run business</strong> built on hard work and hometown values.
          We live here, we raise our kids here, and we’re proud to serve our neighbors across Central Michigan.
          When we say we care about the details, we mean it—because <strong>this is more than just a job to us</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- Community -->
  <section class="section anchor-target" id="community">
    <div class="container container--narrow text-center stack-lg stack">
      <span class="eyebrow">Community</span>
      <h2>The Isabella Difference</h2>
      <p class="lead">
        Our deep roots in the community and personal investment in every project set us apart. We understand that your
        garage door is more than just an entry point—it’s part of your home’s security, functionality, and curb appeal.
        That’s why we approach every service call with the same care and attention we’d want for our own families.
      </p>
    </div>
  </section>

  <!-- Testimonial
  <section>
<a href="/about/testimonials" style="text-decoration: none; color: inherit; display: block;">
    <TestimonialCard
      quote="Our experience with Isabella Garage Door was exceptional. They provided high quality service and made us feel valued as customers. If you're in Mount Pleasant and need garage door services, I wholeheartedly recommend giving them a call. You won't be disappointed!"
      author="Michael S."
    />
</a>
  </section>
-->

  <!-- Mission -->
  <section class="section section--sand">
    <div class="container container--narrow text-center stack-lg stack">
      <span class="eyebrow">Our Purpose</span>
      <h2>Our Mission</h2>
      <p class="mission">
        To elevate the standards of service in the garage door industry by providing quality workmanship and
        exceptional customer care—every project, every time.
      </p>
      <div class="cluster cluster--center">
        <a href="/contact" class="btn btn--navy"><Icon name="handshake" /> Get in Touch</a>
      </div>
    </div>
  </section>

  <BookingCta />
  <ContactBlock text="Built from the ground up right here in Central Michigan—rooted in hard work, integrity, and local pride." />
</BaseLayout>

<style>
  .hero-sub {
    max-width: 40rem;
  }

  .anchor-target {
    scroll-margin-top: calc(var(--header-h, 70px) + 1rem);
  }

  .value-card {
    text-align: center;
  }

  .value-card .card__icon {
    margin-inline: auto;
  }

  .value-card p {
    color: var(--muted);
  }

  .story-pair {
    gap: var(--space-12);
  }

  @media (min-width: 900px) {
    .story-pair {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .highlight {
    position: relative;
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(2rem, 1.5rem + 2vw, 3rem);
    border: 1px solid var(--bronze);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 0% 0%, rgb(255 255 255 / 0.1), transparent 60%),
      linear-gradient(150deg, var(--navy), var(--navy-800));
    box-shadow: var(--shadow-lg);
    color: rgb(255 255 255 / 0.9);
    text-align: center;
  }

  .highlight :global(.highlight__icon) {
    margin: 0 auto var(--space-4);
    color: var(--bronze-300);
  }

  .highlight p {
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.3rem);
    line-height: 1.7;
  }

  .highlight strong {
    color: var(--bronze-300);
    font-weight: 600;
  }

  .mission {
    color: var(--navy);
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.5rem);
    font-style: italic;
    line-height: 1.6;
  }
</style>
