---
title: "Garage Log Archive - Isabella Garage Door"
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import GalleryGrid, { type GalleryPost } from '../../components/about/GalleryGrid.astro';
import BookingCta from '../../components/BookingCta.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Icon from '../../components/ui/Icon.astro';

const title = 'Archive | Isabella Garage Door';
const description = 'Browse our archive of past garage door projects showcasing craftsmanship and quality work across Central Michigan.';


const posts: GalleryPost[] = [
  // Add more posts as needed
  // 1200 by 900 pixels - 4x3
  // upload as webp
  // move older gallery posts here when gallery becomes bloated







  {
    image: "/photos/cable-off-weidman-michigan.webp",
    alt: "Garage Door cable off in Weidman Michigan",
    caption: "Cable came off the drum of this door. Put it back on and made some adjustments. Customers door works once again!",
    date: "2026-06-30"
  },
  {
    image: "/photos/spring-replacement-mount-pleasant-michigan.webp",
    alt: "Garage Door spring replacement in Mt. Pleasant Michigan",
    caption: "Replaced a garage door spring in Mt. Pleasant this morning. The customer was so happy to get her door working again!",
    date: "2026-05-18"
  },
  {
    image: "/photos/garage-door-repair-mt-pleasant-mi.webp",
    alt: "Garage door repaired in Mt. Pleasant",
    caption: "Repaired this garage door this morning. We like the color.",
    date: "2026-05-18"
  },
  {
    image: "/photos/unique-garage-door-opener.webp",
    alt: "Repaired garage door opener in Isabella Township",
    caption: "Worked on a very unique opener today in Rosebush. Never seen one like this before. Glad to get it running again for the customer.",
    date: "2026-04-26"
  },
  {
    image: "/photos/double-torsion-spring-change.webp",
    alt: "Double garage door torsion spring change",
    caption: "Completed a double torsion spring change today. Balanced, tuned, and running smooth!",
    date: "2026-04-08"
  },
  {
    image: "/photos/spring.jpg",
    alt: "Spring replacement in Mt. Pleasant",
    caption: "Quick spring replacement in Mt. Pleasant this morning. Same-day fix before lunch.",
    date: "2026-03-25"
  },
  {
    image: "/photos/photo-eye-replacement.webp",
    alt: "Sensor replacement in Clare",
    caption: "This door wouldnt close unless you held the wall button. turned out to be a bad safety sensor. New photo eyes got their door working again.",
    date: "2026-03-20"
  },

  
  // Add more posts as needed
  // 1200 by 900 pixels - 4x3
  // upload as webp
];

// Sort newest first
const sorted = [...posts].sort((a, b) => b.date.localeCompare(a.date));

// Pagination happens in the browser (?page=N) — see components/Paginate.astro
const perPage = 9;
---

<BaseLayout {title} {description} legacy={false}>
  <PageHero
    title="Garage Door Job Log Archive"
    eyebrow="Gallery Archive"
    intro="An archive of real garage door repairs, installs, and maintenance jobs from across Mt. Pleasant, Clare, Alma, and nearby areas. These posts document our earlier work—organized for reference, not forgotten."
    image="/photos/gallery-archive-garage-door.avif"
    imageAlt="Vintage garage interior with a restored car, evoking the history of garage craftsmanship"
    crumbs={[{ name: 'Gallery', href: '/about/gallery-isabella-garage-door' }, { name: 'Archive', href: '/about/gallery-archive-isabella-garage-door' }]}
  >
    <Fragment slot="actions">
      <a href="/booking" class="btn btn--primary"><Icon name="calendar" /> Book a Service Visit</a>
    </Fragment>
  </PageHero>

  <section class="section section--sand">
    <div class="container">
      <GalleryGrid posts={sorted} perPage={perPage} />

      <p class="gallery-note">
        What you see here may be in the past, but the quality behind it still defines our work today.
      </p>

      <div class="cluster cluster--center mt-8">
        <a href="/booking" class="btn btn--navy"><Icon name="calendar" /> Book a Service Visit</a>
      </div>
    </div>
  </section>

  <BookingCta />
  <ContactBlock text="Browse our project archive — proof of our commitment to quality and detail across Central Michigan homes." />
</BaseLayout>

<style>
  .gallery-note {
    max-width: 46rem;
    margin: var(--space-12) auto 0;
    color: var(--muted);
    font-size: var(--text-lg);
    text-align: center;
  }
</style>
