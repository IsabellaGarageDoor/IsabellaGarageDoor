---
// Redirect target for the contact, estimate and testimonial forms. URL and wording must not change.
// Page <title> intentionally falls back to the site default (as before).
import BaseLayout from '../layouts/BaseLayout.astro';
import ThankYouCard from '../components/contact/ThankYouCard.astro';
import Icon from '../components/ui/Icon.astro';
---

<BaseLayout>
  <ThankYouCard title="Thank You!">
    <p class="message">We’ve received your request and will be in touch within 24 hours or on the next business day.</p>
    <p class="subtext">If you have any questions in the meantime, feel free to <a href="/contact">contact us</a>.</p>
    <Fragment slot="actions">
      <a href="/" class="btn btn--navy btn--lg"><Icon name="home" /> Return to Homepage</a>
    </Fragment>
  </ThankYouCard>
</BaseLayout>
