---
title: "Contact Us - Isabella Garage Door"
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.jsx';
import SaveContactBanner from '../components/SaveContactBanner.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';

const title = 'Request Service | Isabella Garage Door';
const description = 'Get in touch with Isabella Garage Door for fast, friendly, and reliable garage door repairs in Central, Michigan.';

const contactSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://isabellagaragedoor.com/contact",
      "url": "https://isabellagaragedoor.com/contact",
      "name": "Contact Isabella Garage Door",
      "description": "Request a service visit, ask a question, or get a quote for garage door services in Central Michigan.",
      "mainEntity": {
        "@id": "https://isabellagaragedoor.com/#business"
      }
    },
    {
      "@type": "ContactPoint",
      "telephone": "+1-989-572-0303",
      "contactType": "customer service",
      "email": "IsabellaGarageDoor@gmail.com",
      "areaServed": [
        "Mount Pleasant", "Lake Isabella", "Alma", "Clare", "Rosebush", "Shepherd", "Weidman", "Coleman", "Remus", "Beal City", "St. Louis", "Farwell"
      ],
      "availableLanguage": "en"
    }
  ]
};
---
<link rel="stylesheet" href="/styles/global.css" />

<BaseLayout {title} {description}>

<Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  </Fragment>

  <img src="/photos/request-service-garage-door-image.avif" alt="Request garage door service or intallation today in Central Michigan" loading="eager" fetchpriority="high" class="header-photo-interior" />


<h1 class="page-title">Contact Us</h1>

  <p class="left-content">Ready to schedule service, ask a question, or request a quote? We're here to help. Reach out using the form below, or contact us directly - whichever is easiest for you.
</p>

<div id="contact-form" style="position: relative; top: -80px;"></div>
<section class="py-8 px-4 max-w-4xl mx-auto">
  <ContactForm client:visible />
</section>


<h3 class="sub-sub-heading" style="margin-top: 1.5rem; font-family:'Lora', serif;">
  Prefer to talk to someone?
</h3>

<div class="technical-contact">
  
  <div class="contact-row">
    <span class="method">VOICE</span>
    <a href="tel:9895720303">(989) 572-0303</a>
  </div>
  
  <div class="contact-row">
    <span class="method">MOBILE</span>
    <a href="sms:9895720303?body=Hi%2C%20I%20have%20a%20question%20about%20your%20services.">Text a Technician</a>
  </div>
  
  <div class="contact-row">
    <span class="method">INBOX</span>
    <a href="mailto:isabellagaragedoor@gmail.com">Email the Office</a>
  </div>
</div>

<SaveContactBanner />

<ServiceAreaMap /> 

<section>
  <h2 class="sub-heading">Isabella Garage Door</h2>
  <p style="font-size: .9rem; text-align: center;">
    Serving Central Michigan with honest, high-quality garage door service.
  </p>
  <p style="font-size: .9rem; text-align: center; margin: 0.5rem;">
    <em>Raising Performance. Elevating Standards</em>
  </p>
  <p style="font-size: 1rem; text-align: center; margin: 1.5rem auto 0;">
    <strong>Call or text: </strong> <a href="tel:9895720303" style="color: #b27d57; font-size: 1.2rem; font-weight: bold;">989-572-0303</a>
  </p>
</section>

</BaseLayout>