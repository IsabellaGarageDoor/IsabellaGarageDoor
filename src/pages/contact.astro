---
title: "Contact Us - Isabella Garage Door"
import BaseLayout from '../layouts/BaseLayout.astro';
import SaveContactBanner from '../components/SaveContactBanner.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';

const title = 'Contact Us | Isabella Garage Door';
const description = 'Get in touch with Isabella Garage Door for fast, friendly, and reliable garage door repairs in Central, Michigan.';

const contactSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://isabellagaragedoor.com/contact",
      "url": "https://isabellagaragedoor.com/contact",
      "name": "Contact Isabella Garage Door",
      "description": "Request a service visit, ask a question, or get a quote for garage door services in Central Michigan.",
      "mainEntity": {
        "@id": "https://isabellagaragedoor.com/#business"
      }
    },
    {
      "@type": "ContactPoint",
      "telephone": "+1-989-572-0303",
      "contactType": "customer service",
      "email": "IsabellaGarageDoor@gmail.com",
      "areaServed": [
        "Mount Pleasant", "Lake Isabella", "Alma", "Clare", "Rosebush", "Shepherd", "Weidman", "Coleman", "Remus", "Beal City", "St. Louis", "Farwell"
      ],
      "availableLanguage": "en"
    }
  ]
};
---
<link rel="stylesheet" href="/styles/global.css" />

<BaseLayout {title} {description}>

<Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  </Fragment>

  <img src="/photos/request-service-garage-door-image.avif" alt="Request garage door service or intallation today in Central Michigan" loading="eager" fetchpriority="high" class="header-photo-interior" />


<h1 class="page-title">Contact Us</h1>

  <p class="left-content">Ready to schedule service, ask a question, or request a quote? We're here to help. Reach out using the form below, or contact us directly - whichever is easiest for you.
</p>

<div id="contact-form" style="position: relative; top: -80px;"></div>
<section>
  <div class="testimonial-form-section"> <h2 class="testimonial-form-heading">Request Service or an Estimate</h2>
    <p class="testimonial-form-subtext">Fill out the details below and a technician will get back to you shortly.</p>

    <form
      id="contactForm"
      name="contact"
      method="POST"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      class="testimonial-form"
    >
    <input type="hidden" name="form-name" value="contact" />
      <p style="display: none;">
        <label>Don't fill this out if you're human: <input name="bot-field" /></label>
      </p>

      <div class="form-group">
        <label for="name">Your Name *</label>
        <input type="text" id="name" name="name" placeholder="John Doe" required />
      </div>

      <div class="form-group">
        <label for="phone">Phone Number *</label>
        <input type="tel" id="phone" name="phone" placeholder="(989) 555-0123" required />
      </div>

      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" placeholder="john@example.com" />
      </div>

      <div class="form-group">
        <label for="address">Service Address *</label>
        <input type="text" id="address" name="address" placeholder="123 Main St, Mt. Pleasant, MI" required />
      </div>

      <div class="form-group">
        <label for="serviceType">What do you need help with? *</label>
        <select id="serviceType" name="serviceType" required>
          <option value="">Select a service</option>
          <option value="Spring Repair">Broken Spring Repair</option>
          <option value="Opener Issue">Garage Door Opener Issue</option>
          <option value="Door Off Track">Door Off Track / Cable Repair</option>
          <option value="Maintenance">General Maintenance & Tune-Up</option>
          <option value="Quote">New Door Estimate</option>
          <option value="Other">Other (Describe below)</option>
        </select>
      </div>

      <div class="form-group">
        <label for="description">Describe the issue *</label>
        <textarea id="description" name="description" rows="4" placeholder="Please let us know what your garage door is doing..." required></textarea>
      </div>

      <div class="form-group">
        <label for="contactMethod">Preferred Contact Method</label>
        <select id="contactMethod" name="contactMethod">
          <option value="Phone Call">Phone Call</option>
          <option value="Text Message">Text Message</option>
          <option value="Email">Email</option>
        </select>
      </div>

      <div class="form-group">
        <label for="appointmentTime">Preferred Day / Time</label>
        <input type="text" id="appointmentTime" name="appointmentTime" placeholder="e.g., Tuesday mornings, As soon as possible" />
      </div>

      <div class="form-group">
        <label for="referral">How did you hear about us?</label>
        <select id="referral" name="referral">
          <option value="">Select one</option>
          <option value="Google Search">Google Search</option>
          <option value="Facebook">Facebook</option>
          <option value="Friend or Family">Friend or Family</option>
          <option value="Repeat Customer">Repeat Customer</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div class="form-button-wrapper">
        <button type="submit" class="cta-button">Submit Request</button>
      </div>
    </form>
  </div>
</section>


<h3 class="sub-sub-heading" style="margin-top: 1.5rem; font-family:'Lora', serif;">
  Prefer to talk to someone?
</h3>

<div class="technical-contact">
  
  <div class="contact-row">
    <span class="method">VOICE</span>
    <a href="tel:9895720303">(989) 572-0303</a>
  </div>
  
  <div class="contact-row">
    <span class="method">MOBILE</span>
    <a href="sms:9895720303?body=Hi%2C%20I%20have%20a%20question%20about%20your%20services.">Text a Technician</a>
  </div>
  
  <div class="contact-row">
    <span class="method">INBOX</span>
    <a href="mailto:isabellagaragedoor@gmail.com">Email the Office</a>
  </div>
</div>

<SaveContactBanner />

<ServiceAreaMap /> 

<section>
  <h2 class="sub-heading">Isabella Garage Door</h2>
  <p style="font-size: .9rem; text-align: center;">
    Serving Central Michigan with honest, high-quality garage door service.
  </p>
  <p style="font-size: .9rem; text-align: center; margin: 0.5rem;">
    <em>Raising Performance. Elevating Standards</em>
  </p>
  <p style="font-size: 1rem; text-align: center; margin: 1.5rem auto 0;">
    <strong>Call or text: </strong> <a href="tel:9895720303" style="color: #b27d57; font-size: 1.2rem; font-weight: bold;">989-572-0303</a>
  </p>
</section>

<script is:inline>
  document.getElementById('contactForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const form = e.target;
    const formData = new FormData(form);
    
    // Push the submission payload straight to the root domain for Netlify to intercept
    fetch("/", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams(formData).toString()
    })
    .then(() => {
      // Safely redirect to your thank you page after Netlify accepts the data
      window.location.href = "/thank-you-estimate";
    })
    .catch((error) => console.error("Form submission error:", error));
  });
</script>

</BaseLayout>