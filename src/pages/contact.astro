---
import BaseLayout from '../layouts/BaseLayout.astro';
import SaveContactBanner from '../components/SaveContactBanner.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import PageHero from '../components/ui/PageHero.astro';
import ContactBlock from '../components/ContactBlock.astro';
import ContactMethods from '../components/contact/ContactMethods.astro';
import Icon from '../components/ui/Icon.astro';
import '../components/contact/forms.css';

const title = 'Contact Us | Isabella Garage Door';
const description = 'Get in touch with Isabella Garage Door for fast, friendly, and reliable garage door repairs in Central, Michigan.';

const contactSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://isabellagaragedoor.com/contact",
      "url": "https://isabellagaragedoor.com/contact",
      "name": "Contact Isabella Garage Door",
      "description": "Request a service visit, ask a question, or get a quote for garage door services in Central Michigan.",
      "mainEntity": {
        "@id": "https://isabellagaragedoor.com/#business"
      }
    },
    {
      "@type": "ContactPoint",
      "telephone": "+1-989-572-0303",
      "contactType": "customer service",
      "email": "isabellagaragedoor@gmail.com",
      "areaServed": [
        "Mount Pleasant", "Lake Isabella", "Alma", "Clare", "Rosebush", "Shepherd", "Weidman", "Coleman", "Remus", "Beal City", "St. Louis", "Farwell"
      ],
      "availableLanguage": "en"
    }
  ]
};
---

<BaseLayout {title} {description}>

  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  </Fragment>

  <PageHero
    title="Contact Us"
    intro="Ready to schedule service, ask a question, or request a quote? We're here to help. Reach out using the form below, or contact us directly - whichever is easiest for you."
    image="/photos/request-service-garage-door-image.avif"
    imageAlt="Request garage door service or intallation today in Central Michigan"
    crumbs={[{ name: 'Contact Us', href: '/contact' }]}
  />

  <section class="section contact-section">
    <div class="container contact-layout">
      <div id="contact-form" class="form-card contact-form-card">
        <div class="form-card__head">
          <h2 class="form-card__title">Request Service or an Estimate</h2>
          <p class="form-card__sub">Fill out the details below and a technician will get back to you shortly.</p>
        </div>

        <form
          id="contactForm"
          name="contact"
          method="POST"
          action="https://api.web3forms.com/submit"
          class="contact-form"
        >
          <input type="hidden" name="access_key" value="f356bda4-8613-4c1d-92cc-43871d5e272b" />
          <input type="hidden" name="subject" value="New Contact Form Submission - Isabella Garage Door" />
          <input type="hidden" name="redirect" value="https://isabellagaragedoor.com/thank-you-estimate" />
          <input type="checkbox" name="botcheck" style="display: none;" tabindex="-1" autocomplete="off" />

          <div class="form-grid">
            <div class="form-field">
              <label class="form-label" for="name">Your Name *</label>
              <input class="form-control" type="text" id="name" name="name" placeholder="John Doe" autocomplete="name" required />
            </div>

            <div class="form-field">
              <label class="form-label" for="phone">Phone Number *</label>
              <input class="form-control" type="tel" id="phone" name="phone" placeholder="(989) 555-0123" autocomplete="tel" required />
            </div>

            <div class="form-field">
              <label class="form-label" for="email">Email Address</label>
              <input class="form-control" type="email" id="email" name="email" placeholder="john@example.com" autocomplete="email" />
            </div>

            <div class="form-field">
              <label class="form-label" for="address">Service Address *</label>
              <input class="form-control" type="text" id="address" name="address" placeholder="123 Main St, Mt. Pleasant, MI" autocomplete="street-address" required />
            </div>

            <div class="form-field form-field--full">
              <label class="form-label" for="serviceType">What do you need help with? *</label>
              <select class="form-control" id="serviceType" name="serviceType" required>
                <option value="">Select a service</option>
                <option value="Spring Repair">Broken Spring Repair</option>
                <option value="Opener Issue">Garage Door Opener Issue</option>
                <option value="Door Off Track">Door Off Track / Cable Repair</option>
                <option value="Maintenance">General Maintenance & Tune-Up</option>
                <option value="Quote">New Door Estimate</option>
                <option value="Other">Other (Describe below)</option>
              </select>
            </div>

            <div class="form-field form-field--full">
              <label class="form-label" for="description">Describe the issue *</label>
              <textarea class="form-control" id="description" name="description" rows="4" placeholder="Please let us know what your garage door is doing..." required></textarea>
            </div>

            <div class="form-field">
              <label class="form-label" for="contactMethod">Preferred Contact Method</label>
              <select class="form-control" id="contactMethod" name="contactMethod">
                <option value="Phone Call">Phone Call</option>
                <option value="Text Message">Text Message</option>
                <option value="Email">Email</option>
              </select>
            </div>

            <div class="form-field">
              <label class="form-label" for="appointmentTime">Preferred Day / Time</label>
              <input class="form-control" type="text" id="appointmentTime" name="appointmentTime" placeholder="e.g., Tuesday mornings, As soon as possible" />
            </div>

            <div class="form-field form-field--full">
              <label class="form-label" for="referral">How did you hear about us?</label>
              <select class="form-control" id="referral" name="referral">
                <option value="">Select one</option>
                <option value="Google Search">Google Search</option>
                <option value="Facebook">Facebook</option>
                <option value="Friend or Family">Friend or Family</option>
                <option value="Repeat Customer">Repeat Customer</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn--primary btn--lg contact-submit">
              <Icon name="check-circle" /> Submit Request
            </button>
          </div>
        </form>
      </div>

      <aside class="contact-aside">
        <ContactMethods
          heading="Prefer to talk to someone?"
          headingLevel="h3"
          sms="sms:+19895720303?&body=Hi%2C%20I%20have%20a%20question%20about%20your%20services."
        />
        <SaveContactBanner />
      </aside>
    </div>
  </section>

  <ServiceAreaMap />

  <ContactBlock text="Serving Central Michigan with honest, high-quality garage door service." />

</BaseLayout>

<style>
  .contact-section {
    background: var(--sand);
  }

  .contact-layout {
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }

  @media (min-width: 1000px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      gap: var(--space-12);
    }

    .contact-aside {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      padding-top: var(--space-6);
    }
  }

  @media (max-width: 639px) {
    .contact-submit {
      width: 100%;
    }
  }
</style>
