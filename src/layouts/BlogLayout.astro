---
// Blog article layout: header (breadcrumbs, title, date, reading time, photo),
// readable article body, sharing, free-guide signup, related posts, booking CTA.
import BaseLayout from './BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import ConvertKitForm from '../components/ConvertKitForm.astro';
import YouMayAlsoLike from '../components/YouMayAlsoLike.astro';
import BookingCta from '../components/BookingCta.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { publicPath, absoluteUrl } from '../lib/urls';
import { site } from '../config/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  /** The article's own heading (from the markdown "# Heading") */
  heading?: string;
}

const { post, heading } = Astro.props;
const { title = site.name, description, pubDate, thumbnail, author = site.name } = post.data;
const path = publicPath(Astro.url);
const fullUrl = absoluteUrl(path, Astro.site);
const articleTitle = heading || title;

const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const dateLabel = pubDate
  ? new Date(pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : '';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: articleTitle,
  description,
  datePublished: pubDate,
  image: thumbnail ? absoluteUrl(thumbnail, Astro.site) : undefined,
  author: { '@type': 'Organization', name: author, url: site.url },
  publisher: { '@id': `${site.url}/#business` },
  mainEntityOfPage: fullUrl,
};
---

<BaseLayout title={title} description={description} image={thumbnail} fullUrl={fullUrl} type="article" legacy={false}>
  <Fragment slot="head">
    {pubDate && <meta property="article:published_time" content={pubDate} />}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <article class="article">
    <header class="article-header">
      <div class="container container--narrow">
        <Breadcrumbs
          tone="light"
          items={[
            { name: 'Learning Center', href: '/resources/learning-center' },
            { name: title, href: path },
          ]}
        />
        <span class="eyebrow">Learning Center</span>
        <h1>{articleTitle}</h1>
        <p class="article-meta">
          {dateLabel && <time datetime={pubDate}>{dateLabel}</time>}
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
          <span aria-hidden="true">·</span>
          <span>By {author}</span>
        </p>
      </div>
      {thumbnail && (
        <div class="container article-photo">
          <img src={thumbnail} alt={title} loading="eager" fetchpriority="high" decoding="async" />
        </div>
      )}
    </header>

    <div class="container container--narrow">
      <div class="prose article-body">
        <slot />
      </div>

      <footer class="article-footer">
        <h2 class="article-footer__label">Share this page</h2>
        <ShareButtons url={path} />
      </footer>
    </div>
  </article>

  <section class="section section--tight">
    <div class="container container--narrow">
      <div class="guide-card">
        <img src="/photos/EbookCover3.webp" alt="Garage Door Tips From a Professional" class="guide-card__cover" loading="lazy" />
        <div class="guide-card__body">
          <span class="eyebrow">Free Guide</span>
          <h2>Get Our Free Guide</h2>
          <p>
            Keep your garage door running smoothly, avoid costly repairs, and extend its lifespan with these
            must-know tips—straight from a local pro.
          </p>
          <ConvertKitForm />
          <p class="guide-card__note">
            We’ll send your Free Garage Door Guide instantly and only email you with helpful tips and reminders —no spam, ever.
          </p>
        </div>
      </div>
    </div>
  </section>

  <YouMayAlsoLike currentSlug={post.id} />
  <BookingCta />
</BaseLayout>

<style>
  .article-header {
    padding-top: clamp(2rem, 1rem + 3vw, 3.5rem);
    background: linear-gradient(180deg, var(--sand) 0%, var(--cream) 100%);
  }

  .article-header .container--narrow > * + * {
    margin-top: var(--space-5);
  }

  .article-header h1 {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .article-photo {
    max-width: calc(980px + 2 * var(--gutter));
    margin-top: var(--space-10);
  }

  .article-photo img {
    width: 100%;
    max-height: 560px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .article-body {
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem) var(--space-8);
  }

  /* A horizontal rule that used to sit right under the old in-body title */
  .article-body > :global(hr:first-child) {
    display: none;
  }

  .article-body > :global(:first-child) {
    margin-top: 0;
  }

  .article-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .article-footer__label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .guide-card {
    display: grid;
    gap: var(--space-8);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .guide-card__cover {
    width: 180px;
    margin-inline: auto;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
  }

  .guide-card__body > * + * {
    margin-top: var(--space-4);
  }

  .guide-card__body p {
    color: var(--muted);
  }

  .guide-card__note {
    font-size: var(--text-xs);
  }

  @media (min-width: 720px) {
    .guide-card {
      grid-template-columns: 180px 1fr;
      align-items: center;
    }
  }
</style>
